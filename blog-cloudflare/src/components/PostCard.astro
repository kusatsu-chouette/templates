---
// templates/blog-cloudflare/src/components/PostCard.astro
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import Byline from "./Byline.astro";
import { formatDate } from "../utils/locale";
import { formatReadingTime, getReadingTime } from "../utils/reading-time";

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	tags?: Array<{ slug: string; label: string }>;
	variant?: "card" | "feature" | "row";
	headingLevel?: 2 | 3;
	priority?: boolean;
}

const {
	post,
	tags = [],
	variant = "card",
	headingLevel = 2,
	priority = false,
} = Astro.props;

const Heading = `h${headingLevel}` as const;
const href = `/posts/${post.id}`;
const titleId = `post-${variant}-${post.id}`;
const title = post.data.title || "無題のコラム";
const publishedAt = post.data.publishedAt ?? null;
const readingTime = formatReadingTime(getReadingTime(post.data.content));
const bylines = post.data.bylines ?? [];
const visibleTags = tags.slice(0, variant === "card" ? 2 : 3);

const sizes = {
	card: "(min-width: 1080px) 360px, (min-width: 700px) 45vw, 100vw",
	feature: "(min-width: 900px) 640px, 100vw",
	row: "(min-width: 720px) 240px, 120px",
}[variant];
---

<article class:list={["post", `post--${variant}`]}>
	<a href={href} class="post__media" tabindex="-1" aria-hidden="true">
		{
			post.data.featured_image ? (
				<div class="post__image" {...post.edit.featured_image}>
					<Image
						image={post.data.featured_image}
						sizes={sizes}
						priority={priority}
					/>
				</div>
			) : (
				<div class="post__placeholder">
					<svg class="post__placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
					</svg>
					<span class="post__placeholder-text">La Chouette Note</span>
				</div>
			)
		}
	</a>

	<div class="post__body">
		<a href={href} class="post__link" aria-labelledby={titleId}>
			<span class="post__meta">
				{
					publishedAt && (
						<time datetime={publishedAt.toISOString()}>
							{formatDate(publishedAt, "short")}
						</time>
					)
				}
				<span class="post__reading-time">{readingTime}</span>
			</span>

			<Heading class="post__title" id={titleId} {...post.edit.title}>
				{title}
			</Heading>

			{
				post.data.excerpt && (
					<p class="post__excerpt" {...post.edit.excerpt}>
						{post.data.excerpt}
					</p>
				)
			}

			{
				variant === "feature" && (
					<span class="post__cta" aria-hidden="true">
						記事を読む
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</span>
				)
			}
		</a>

		{
			(bylines.length > 0 || visibleTags.length > 0) && (
				<div class="post__footer">
					{bylines.length > 0 && (
						<Byline
							bylines={bylines}
							max={variant === "card" ? 1 : 2}
							size={variant === "feature" ? "sm" : "xs"}
						/>
					)}
					{visibleTags.length > 0 && (
						<ul class="post__tags" aria-label="カテゴリー・タグ">
							{visibleTags.map((tag) => (
								<li>
									<a href={`/category/${tag.slug}`} class="post__tag-chip">
										{tag.label}
									</a>
								</li>
							))}
						</ul>
					)}
				</div>
			)
		}
	</div>
</article>

<style>
	.post {
		--c-alabaster: #F7F4EF;
		--c-champagne: #EDE7DF;
		--c-sand: #DCD3C6;
		--c-bronze: #8E735B;
		--c-charcoal: #221F1D;
		--c-taupe: #7D7571;

		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		border-radius: 1.25rem;
		transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.post:has(.post__link:focus-visible) {
		outline: 2px solid var(--c-bronze);
		outline-offset: 3px;
	}

	@supports selector(:has(*)) {
		.post__link:focus-visible {
			outline: none;
		}
	}

	.post__media {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: 1rem;
		background: var(--c-champagne);
		border: 1px solid var(--c-sand);
	}

	.post__image {
		height: 100%;
		width: 100%;
	}

	.post__image :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.post:has(.post__link:hover, .post__media:hover) .post__image :global(img) {
		transform: scale(1.04);
	}

	.post__placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #EDE7DF 0%, #E3D9CC 100%);
		padding: 1.5rem;
		text-align: center;
	}

	.post__placeholder-icon {
		width: 2.25rem;
		height: 2.25rem;
		color: rgba(142, 115, 91, 0.7);
		margin-bottom: 0.5rem;
		transition: transform 0.3s ease;
	}

	.post:has(.post__link:hover, .post__media:hover) .post__placeholder-icon {
		transform: scale(1.1);
	}

	.post__placeholder-text {
		font-family: "Shippori Mincho", serif;
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		color: var(--c-taupe);
		text-transform: uppercase;
	}

	.post__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}

	.post__link {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		color: inherit;
		text-decoration: none;
	}

	.post__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 0.5rem;
		font-size: 0.78rem;
		color: var(--c-taupe);
		font-variant-numeric: tabular-nums;
		margin-top: 0.25rem;
	}

	.post__meta > :not(:last-child)::after {
		content: "•";
		margin-inline-start: 0.5rem;
		opacity: 0.6;
	}

	.post__title {
		font-family: "Shippori Mincho", serif;
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.55;
		color: var(--c-charcoal);
		letter-spacing: 0.02em;
		transition: color 0.2s ease;
	}

	.post:has(.post__link:hover) .post__title {
		color: var(--c-bronze);
	}

	.post__excerpt {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--c-taupe);
	}

	.post__excerpt[data-emdash-editing] {
		display: block;
		-webkit-line-clamp: unset;
		overflow: visible;
	}

	.post__footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid rgba(220, 211, 198, 0.6);
	}

	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.post__tag-chip {
		display: inline-block;
		padding: 0.25rem 0.65rem;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--c-bronze);
		background-color: var(--c-alabaster);
		border: 1px solid var(--c-sand);
		border-radius: 9999px;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.post__tag-chip:hover {
		background-color: var(--c-champagne);
		color: var(--c-charcoal);
	}

	.post--card {
		padding: 1.25rem;
		background: #FFFFFF;
		border: 1px solid var(--c-sand);
		box-shadow: 0 2px 8px rgba(34, 31, 29, 0.03);
	}

	.post--card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(34, 31, 29, 0.07);
		border-color: rgba(142, 115, 91, 0.4);
	}

	.post--card .post__link {
		padding: 1rem 0.25rem 0.75rem;
	}

	.post--feature {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		padding: 1.75rem;
		background: #FFFFFF;
		border: 1px solid var(--c-sand);
		box-shadow: 0 4px 16px rgba(34, 31, 29, 0.04);
		gap: 1.5rem;
	}

	.post--feature:hover {
		box-shadow: 0 12px 30px rgba(34, 31, 29, 0.08);
	}

	.post--feature .post__media {
		aspect-ratio: 4 / 3;
	}

	.post--feature .post__body {
		justify-content: center;
		padding: clamp(1rem, 0.5rem + 1.5vw, 2.5rem);
	}

	.post--feature .post__title {
		font-size: clamp(1.4rem, 1rem + 1.2vw, 2rem);
		line-height: 1.4;
	}

	.post--feature .post__excerpt {
		-webkit-line-clamp: 3;
		font-size: 0.95rem;
	}

	.post--feature .post__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--c-bronze);
	}

	.post--feature .post__cta svg {
		width: 1rem;
		height: 1rem;
		transition: transform 0.2s ease;
	}

	.post--feature:has(.post__link:hover) .post__cta svg {
		transform: translateX(4px);
	}

	.post--row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(7.5rem, 24%, 14rem);
		align-items: start;
		gap: 1.5rem;
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--c-sand);
		border-radius: 0;
	}

	.post--row .post__media {
		grid-column: 2;
		grid-row: 1;
	}

	.post--row .post__body {
		grid-column: 1;
		grid-row: 1;
	}

	.post--row .post__title {
		font-size: 1.2rem;
	}

	@media (max-width: 900px) {
		.post--feature {
			grid-template-columns: minmax(0, 1fr);
		}

		.post--feature .post__media {
			aspect-ratio: 16 / 9;
		}

		.post--feature .post__body {
			padding: 1rem 0 0;
		}
	}

	@media (max-width: 560px) {
		.post--row {
			grid-template-columns: minmax(0, 1fr) 5.5rem;
			gap: 1rem;
		}

		.post--row .post__media {
			aspect-ratio: 1;
		}

		.post--row .post__title {
			font-size: 1rem;
		}
	}
</style>
