---
// templates/blog-cloudflare/src/components/Header.astro
const navItems = [
  { label: 'ホーム', href: '/' },
  { label: 'プロフィール', href: '/therapist' },
  { label: 'メニュー', href: '/menu' },
  { label: '口コミ', href: '/reviews' },
  { label: 'アクセス', href: '/access' },
  { label: 'お問い合わせ', href: '/contact' },
];
---

<header class="bg-alabaster/95 backdrop-blur-sm border-b border-sand/40 sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex flex-col items-center text-center">
    <!-- 英語サブ表記 -->
    <p class="text-[10px] tracking-[0.25em] text-taupe uppercase font-light mb-1">
      WOMEN ONLY — PRIVATE OIL MASSAGE SANCTUARY
    </p>

    <!-- 屋号ロゴ -->
    <a href="/" class="group inline-block">
      <h1 class="text-2xl sm:text-3xl font-serif tracking-widest text-charcoal group-hover:text-bronze transition-colors duration-300">
        La Chouette <span class="text-xs sm:text-sm font-sans tracking-normal text-taupe ml-1">— ラ・シュエット —</span>
      </h1>
    </a>

    <!-- 店舗基本情報 -->
    <p class="text-[11px] text-taupe tracking-wider mt-1 font-light">
      滋賀県草津市大路 ｜ OPEN 8-00 — 27-00（女性専用・完全個室）
    </p>

    <!-- グローバルナビゲーション -->
    <nav class="mt-4 flex flex-wrap items-center justify-center gap-x-5 sm:gap-x-8 gap-y-2 text-xs tracking-widest text-charcoal font-medium">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="relative py-1 hover:text-bronze transition-colors duration-200 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-bronze hover:after:w-full after:transition-all after:duration-300"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
