---
// templates/blog-cloudflare/src/components/Header.astro
const navItems = [
  { label: 'ホーム', href: '/' },
  { label: 'プロフィール', href: '/therapist' },
  { label: 'メニュー', href: '/menu' },
  { label: '口コミ', href: '/reviews' },
  { label: 'ブログ', href: '/posts' },
  { label: 'アクセス', href: '/access' },
  { label: 'お問い合わせ', href: '/contact' },
];
---

<!-- ブラウザのタブ左側にアイコンを表示（全ページ共通反映） -->
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='26' fill='%238E735B'/%3E%3Cpath d='M 50 20 C 40 20, 32 17, 26 15 C 24 22, 22 34, 22 48 C 22 68, 34 83, 50 83 C 66 83, 78 68, 78 48 C 78 34, 76 22, 74 15 C 68 17, 60 20, 50 20 Z' fill='%23F7F4EF'/%3E%3Cellipse cx='50' cy='65' rx='17' ry='13' fill='%23EDE7DF'/%3E%3Ccircle cx='28' cy='52' r='5' fill='%23DCD3C6' opacity='0.7'/%3E%3Ccircle cx='72' cy='52' r='5' fill='%23DCD3C6' opacity='0.7'/%3E%3Ccircle cx='37' cy='44' r='8.5' fill='%238E735B'/%3E%3Ccircle cx='63' cy='44' r='8.5' fill='%238E735B'/%3E%3Ccircle cx='34.5' cy='41.5' r='3.2' fill='%23F7F4EF'/%3E%3Ccircle cx='60.5' cy='41.5' r='3.2' fill='%23F7F4EF'/%3E%3Ccircle cx='39' cy='46.5' r='1.4' fill='%23F7F4EF'/%3E%3Ccircle cx='65' cy='46.5' r='1.4' fill='%23F7F4EF'/%3E%3Cpolygon points='46,47 54,47 50,54' fill='%238E735B'/%3E%3Crect x='40' y='81' width='7' height='4' rx='2' fill='%238E735B'/%3E%3Crect x='53' y='81' width='7' height='4' rx='2' fill='%238E735B'/%3E%3C/svg%3E">

<header class="bg-alabaster/95 backdrop-blur-sm border-b border-sand/40 sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex flex-col items-center text-center">
    <!-- 英語サブ表記 -->
    <p class="text-[10px] tracking-[0.25em] text-taupe uppercase font-light mb-1">
      WOMEN ONLY — PRIVATE OIL MASSAGE SANCTUARY
    </p>

    <!-- 屋号ロゴ（左側にフクロウアイコンを配置） -->
    <a href="/" class="group inline-flex items-center justify-center gap-3">
      <!-- フクロウアイコン -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-8 h-8 sm:w-9 sm:h-9 shrink-0 transition-transform duration-300 group-hover:scale-105">
        <rect width="100" height="100" rx="26" fill="#8E735B" />
        <path d="M 50 20 C 40 20, 32 17, 26 15 C 24 22, 22 34, 22 48 C 22 68, 34 83, 50 83 C 66 83, 78 68, 78 48 C 78 34, 76 22, 74 15 C 68 17, 60 20, 50 20 Z" fill="#F7F4EF" />
        <ellipse cx="50" cy="65" rx="17" ry="13" fill="#EDE7DF" />
        <circle cx="28" cy="52" r="5" fill="#DCD3C6" opacity="0.7" />
        <circle cx="72" cy="52" r="5" fill="#DCD3C6" opacity="0.7" />
        <circle cx="37" cy="44" r="8.5" fill="#8E735B" />
        <circle cx="63" cy="44" r="8.5" fill="#8E735B" />
        <circle cx="34.5" cy="41.5" r="3.2" fill="#F7F4EF" />
        <circle cx="60.5" cy="41.5" r="3.2" fill="#F7F4EF" />
        <circle cx="39" cy="46.5" r="1.4" fill="#F7F4EF" />
        <circle cx="65" cy="46.5" r="1.4" fill="#F7F4EF" />
        <polygon points="46,47 54,47 50,54" fill="#8E735B" />
        <rect x="40" y="81" width="7" height="4" rx="2" fill="#8E735B" />
        <rect x="53" y="81" width="7" height="4" rx="2" fill="#8E735B" />
      </svg>

      <h1 class="text-2xl sm:text-3xl font-serif tracking-widest text-charcoal group-hover:text-bronze transition-colors duration-300">
        La Chouette <span class="text-xs sm:text-sm font-sans tracking-normal text-taupe ml-1">— ラ・シュエット —</span>
      </h1>
    </a>

    <!-- 店舗基本情報 -->
    <p class="text-[11px] text-taupe tracking-wider mt-1 font-light">
      滋賀県草津市大路 ｜ OPEN 8-00 — 27-00（女性専用・完全個室）
    </p>

    <!-- グローバルナビゲーション -->
    <nav class="mt-4 flex flex-wrap items-center justify-center gap-x-5 sm:gap-x-8 gap-y-2 text-xs tracking-widest text-charcoal font-medium">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="relative py-1 hover:text-bronze transition-colors duration-200 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-bronze hover:after:w-full after:transition-all after:duration-300"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
