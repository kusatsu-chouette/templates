---
// templates/blog-cloudflare/src/components/CounselingCta.astro
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// 連絡先設定
const officialLineUrl = "https://lin.ee/Sv8oVDh";
const directLineId = "chouette3290";
const directLineUrl = "https://line.me/ti/p/~" + directLineId;
const emailAddress = "kusatsu.chouette@gmail.com";

const mailSubject = encodeURIComponent("【相談】ブログ「セラピストの控室」を読んで");
const mailBody = encodeURIComponent("お名前（ニックネーム可）：\n\nご相談内容：\n");
const mailtoUrl = "mailto:" + emailAddress + "?subject=" + mailSubject + "&body=" + mailBody;
---

<div class={"my-12 p-6 sm:p-8 rounded-2xl bg-[#EDE7DF] border border-[#DCD3C6] shadow-sm text-[#221F1D] " + className}>
  <!-- ヘッダー部 -->
  <div class="text-center max-w-xl mx-auto mb-6">
    <span class="inline-block text-xs font-semibold tracking-wider text-[#8E735B] bg-[#F7F4EF] px-3 py-1 rounded-full mb-3 border border-[#DCD3C6]/60">
      Private Consultation
    </span>
    <h3 class="text-xl sm:text-2xl font-bold mb-3 tracking-wide text-[#221F1D]">
      ひとりで抱え込まず、心の内をお話しください
    </h3>
    <p class="text-sm text-[#7D7571] leading-relaxed">
      サロンの施術予約とは別に、お仕事・人間関係・誰にも話せないお悩みなど、個人的な対話・相談窓口を設けております。日常の息抜きや気持ちの整理に、お気軽にご連絡ください。
    </p>
  </div>

  <!-- 3つの連絡ボタン -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-3xl mx-auto">
    <!-- 1. 公式LINE -->
    <a
      href={officialLineUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center p-4 bg-[#F7F4EF] hover:bg-[#06C755]/10 border border-[#DCD3C6] hover:border-[#06C755] rounded-xl transition duration-200 group text-center"
    >
      <div class="w-10 h-10 rounded-full bg-[#06C755] flex items-center justify-center text-white mb-2 shadow-sm group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 5.92 2 10.75c0 2.94 1.67 5.53 4.25 7.02-.19.67-.68 2.44-.78 2.82-.12.47.17.46.36.33.15-.1 2.37-1.61 3.33-2.27.56.09 1.15.15 1.84.15 5.52 0 10-3.92 10-8.75S17.52 2 12 2z"/>
        </svg>
      </div>
      <span class="font-bold text-sm text-[#221F1D] group-hover:text-[#06C755]">サロン公式LINE</span>
      <span class="text-xs text-[#7D7571] mt-1">まずはお気軽に挨拶から</span>
    </a>

    <!-- 2. セラピスト直通LINE -->
    <a
      href={directLineUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center p-4 bg-[#F7F4EF] hover:bg-[#8E735B]/10 border border-[#DCD3C6] hover:border-[#8E735B] rounded-xl transition duration-200 group text-center"
    >
      <div class="w-10 h-10 rounded-full bg-[#8E735B] flex items-center justify-center text-white mb-2 shadow-sm group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5 fill-none stroke-currentColor stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <span class="font-bold text-sm text-[#221F1D] group-hover:text-[#8E735B]">セラピスト直通LINE</span>
      <span class="text-xs text-[#7D7571] mt-1">ID: chouette3290</span>
    </a>

    <!-- 3. メール -->
    <a
      href={mailtoUrl}
      class="flex flex-col items-center justify-center p-4 bg-[#F7F4EF] hover:bg-[#8E735B]/10 border border-[#DCD3C6] hover:border-[#8E735B] rounded-xl transition duration-200 group text-center"
    >
      <div class="w-10 h-10 rounded-full bg-[#7D7571] flex items-center justify-center text-white mb-2 shadow-sm group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5 fill-none stroke-currentColor stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <span class="font-bold text-sm text-[#221F1D] group-hover:text-[#8E735B]">メールで相談</span>
      <span class="text-xs text-[#7D7571] mt-1">LINEを使わない方向け</span>
    </a>
  </div>

  <div class="text-center mt-5 text-[11px] text-[#7D7571]">
    ※プライバシーは厳守いたします。施術の営業や強引な勧誘等は一切ございませんのでご安心ください。
  </div>
</div>
