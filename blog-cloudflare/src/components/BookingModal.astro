---
// src/components/BookingModal.astro
---

<div id="booking-modal" class="custom-modal" aria-hidden="true">
  <div class="modal-backdrop" id="modal-backdrop"></div>
  <div class="modal-dialog">
    <button type="button" class="modal-close-btn" id="modal-close" aria-label="閉じる">&times;</button>
    <div class="modal-body">
      <h3 class="modal-title">ご予約・お問い合わせ</h3>
      <p class="modal-desc">
        当サロンは完全予約制となっております。<br />
        ご都合のよい方法よりお気軽にご連絡ください。
      </p>

      <div class="modal-action-list">
        <!-- 1. WEB即時予約（Square） -->
        <a
          href="https://app.squareup.com/appointments/book/fqk7s06sbwkojt/L7STD9CD9RRTC/start"
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn btn-web"
        >
          <span class="btn-sub">空き状況をカレンダーで確認</span>
          WEB予約サイト（24時間受付）
        </a>

        <!-- 2. 公式LINE予約 -->
        <a
          href="https://lin.ee/Sv8oVDh"
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn btn-line"
        >
          公式LINEから予約・相談する
        </a>

        <!-- 3. お電話（タップで発信） -->
        <a
          href="tel:08062193290"
          class="action-btn btn-tel"
        >
          電話をかける（080-6219-3290）
        </a>

        <!-- 4. メール問い合わせ -->
        <a
          href="mailto:kusatsu.chouette@gmail.com"
          class="action-btn btn-mail"
        >
          メールでお問い合わせ
        </a>
      </div>

      <!-- 5. 直通LINE案内（公式LINEに不安がある方向け） -->
      <div class="modal-direct-box">
        <p class="direct-box-title">公式LINE等のご利用に不安がある方へ</p>
        <p class="direct-box-desc">
          どうしても公式LINEなどのご利用が心配な方は、男性セラピスト直通LINEへ直接ご連絡ください。
        </p>
        <div class="direct-box-id-badge">
          <span class="id-label">直通LINE ID:</span>
          <span class="id-code">chouette3290</span>
        </div>
        <a
          href="https://line.me/ti/p/~chouette3290"
          target="_blank"
          rel="noopener noreferrer"
          class="direct-line-btn"
        >
          セラピスト直通LINEを開く
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }
  .custom-modal.is-active {
    display: flex;
  }
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.65);
  }
  .modal-dialog {
    position: relative;
    background: #ffffff;
    width: 100%;
    max-width: 440px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 12px;
    padding: 2.25rem 1.5rem 1.75rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    z-index: 1;
    box-sizing: border-box;
    text-align: center;
    -webkit-overflow-scrolling: touch;
  }
  .modal-close-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: transparent;
    border: none;
    font-size: 1.8rem;
    line-height: 1;
    color: #888888;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }
  .modal-title {
    font-size: 1.25rem;
    color: #332d29;
    margin: 0 0 0.75rem;
    font-weight: 700;
  }
  .modal-desc {
    font-size: 0.9rem;
    color: #554e48;
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }
  .modal-action-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: opacity 0.2s, transform 0.15s;
    box-sizing: border-box;
  }
  .action-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .btn-sub {
    font-size: 0.75rem;
    font-weight: 400;
    margin-bottom: 2px;
    opacity: 0.9;
  }

  /* 予約サイト（Square）：メインカラー */
  .btn-web {
    background-color: #5c4b43;
    color: #ffffff;
  }

  /* LINE：ブランドグリーン */
  .btn-line {
    background-color: #06c755;
    color: #ffffff;
  }

  /* 電話：落ち着いたアーストーン */
  .btn-tel {
    background-color: #f7f4f1;
    color: #4a3e37;
    border: 1px solid #dcd4ce;
  }

  /* メール：シンプルな枠線ボタン */
  .btn-mail {
    background-color: #ffffff;
    color: #665b53;
    border: 1px solid #dcd4ce;
  }

  /* 直通LINE案内カード */
  .modal-direct-box {
    margin-top: 1.25rem;
    padding: 1rem 0.85rem;
    background-color: #fbf9f6;
    border: 1px solid #dcd3c6;
    border-radius: 8px;
    text-align: center;
  }
  .direct-box-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #4a3e37;
    margin: 0 0 0.35rem;
  }
  .direct-box-desc {
    font-size: 0.78rem;
    color: #6b635d;
    line-height: 1.5;
    margin: 0 0 0.65rem;
  }
  .direct-box-id-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background-color: #ffffff;
    border: 1px dashed #c4b8ab;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    margin-bottom: 0.65rem;
  }
  .id-label {
    color: #7d7571;
    font-size: 0.75rem;
  }
  .id-code {
    font-weight: 700;
    color: #221f1d;
    letter-spacing: 0.03em;
    user-select: all;
  }
  .direct-line-btn {
    display: block;
    width: 100%;
    padding: 0.55rem 0.75rem;
    background-color: #8e735b;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.2s, opacity 0.2s;
    box-sizing: border-box;
  }
  .direct-line-btn:hover {
    background-color: #78614c;
    opacity: 0.95;
  }
</style>

<script>
  const modal = document.getElementById('booking-modal');
  const closeBtn = document.getElementById('modal-close');
  const backdrop = document.getElementById('modal-backdrop');

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest('.js-open-booking')) {
      event.preventDefault();
      modal?.classList.add('is-active');
    }
  });

  const closeModal = () => {
    modal?.classList.remove('is-active');
  };

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
</script>
