---
import LateNightBanner from './LateNightBanner.astro';

// リピーター様専用予約リンク設定
const squareBookingUrl = "https://app.squareup.com/appointments/book/fqk7s06sbwkojt/L7STD9CD9RRTC/start";
const lineBookingUrl = "https://lin.ee/nzuEONf"; // サロンの公式LINE友だち追加URL
const phoneTel = "tel:08062193290";
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 pt-4 sm:pt-6 pb-12">
  <!-- メインヒーローバナー -->
  <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-md border border-sand/40 bg-charcoal aspect-[4/3] sm:aspect-[16/9] lg:aspect-[2/1] flex flex-col justify-between p-4 sm:p-10">
    
    <!-- 背景動画 & フォールバック静止画 & 上品な薄暗グラデーション -->
    <video
      autoplay
      muted
      loop
      playsinline
      poster="https://kusatsu-aroma.com/_emdash/api/media/file/01M63112AR4AJ7H9SMFBDYZDE8.01M6311348MM788S5PG8NN06NP.jpg"
      class="absolute inset-0 w-full h-full object-cover object-center z-0"
    >
      <source src="https://kusatsu-aroma.com/_emdash/api/media/file/01M6B9CSGT2N73Q5ZHEREDG9S4.01M6B9CTB8TKN1K098SB14N3RZ.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/40 to-charcoal/30 z-10"></div>

    <!-- 上部：ミニマルな属性タグ（これだけに絞って映像を邪魔しない） -->
    <div class="relative z-20 flex items-center justify-between">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] sm:text-xs font-serifJp tracking-widest bg-charcoal/50 backdrop-blur-md text-alabaster border border-white/15">
        女性専用・完全個室
      </span>
      <span class="text-[10px] sm:text-xs font-serifEn tracking-[0.25em] text-sand/80 uppercase">
        Kusatsu, Shiga
      </span>
    </div>

    <!-- 下部：新コンセプト＆タグライン（洗練されたタイポグラフィ） -->
    <div class="relative z-20 max-w-xl mt-auto pt-4">
      <p class="text-[10px] sm:text-xs font-serifEn tracking-[0.25em] text-sand uppercase mb-1.5 sm:mb-2">
        PRIVATE OIL MASSAGE SANCTUARY
      </p>

      <h1 class="font-serifJp text-xl sm:text-3xl lg:text-4xl text-alabaster tracking-wider leading-[1.5] drop-shadow-sm font-normal">
        カラダに優しい。<br>
        ココロに優しい。<br>
        サイフに優しい。
      </h1>

      <p class="font-serifJp text-xs sm:text-sm text-sand/90 tracking-widest mt-2 sm:mt-3 font-light">
        ベテラン男性セラピストのオイルトリートメント
      </p>
    </div>
  </div>

  <!-- リピーター様専用 クイック予約バー -->
  <div class="mt-4 rounded-2xl bg-champagne/80 border border-sand/70 p-4 sm:p-5 flex flex-col md:flex-row items-center justify-between gap-3 shadow-sm">
    <div class="flex items-center gap-3 text-center sm:text-left w-full md:w-auto justify-center sm:justify-start">
      <span class="w-8 h-8 rounded-full bg-bronze/15 text-bronze flex items-center justify-center shrink-0 text-sm font-serif">
        ✦
      </span>
      <div>
        <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light">FOR REPEAT CLIENTS</p>
        <h3 class="text-sm sm:text-base font-serif text-charcoal tracking-wide font-medium">
          リピーター様専用クイック予約
        </h3>
      </div>
    </div>
    
    <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full md:w-auto">
      <a
        href={squareBookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 sm:flex-none inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl bg-bronze hover:opacity-90 text-alabaster text-xs tracking-wider transition-all duration-300 shadow-sm font-medium whitespace-nowrap text-center"
      >
        WEB即時予約
      </a>
      <a
        href={lineBookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 sm:flex-none inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl bg-alabaster hover:bg-white text-charcoal border border-sand text-xs tracking-wider transition-all duration-300 shadow-sm font-medium whitespace-nowrap text-center"
      >
        公式LINE予約
      </a>
      <a
        href={phoneTel}
        class="flex-1 sm:flex-none inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl bg-alabaster hover:bg-white text-charcoal border border-sand text-xs tracking-wider transition-all duration-300 shadow-sm font-medium whitespace-nowrap text-center"
      >
        お電話予約
      </a>
    </div>
  </div>

  <!-- 近日の深夜営業日アナウンスバナー -->
  <div class="mt-4">
    <LateNightBanner />
  </div>

  <!-- 下部 特徴・案内カード（3カラム：バナー内から重複を消したためすっきり機能） -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 mt-4">
    <!-- カード1: 営業時間 -->
    <div class="bg-champagne/60 border border-sand/70 rounded-2xl p-4 sm:p-5 text-center transition-all duration-300 hover:border-bronze/40">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1 font-serifEn">OPEN HOURS</p>
      <p class="text-lg sm:text-xl font-serif text-charcoal tracking-wider">8:00 — 27:00</p>
      <p class="text-xs text-taupe mt-1 font-light">朝〜深夜3時迄受付</p>
    </div>

    <!-- カード2: ベテラン男性セラピスト -->
    <div class="bg-champagne/60 border border-sand/70 rounded-2xl p-4 sm:p-5 text-center transition-all duration-300 hover:border-bronze/40">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1 font-serifEn">THERAPIST</p>
      <p class="text-lg sm:text-xl font-serif text-bronze tracking-wider font-medium">施術歴15年（男性専任）</p>
      <p class="text-xs text-taupe mt-1 font-light">包み込む大きな手と安心の空間</p>
    </div>

    <!-- カード3: 特典案内 -->
    <div class="bg-champagne/60 border border-sand/70 rounded-2xl p-4 sm:p-5 text-center transition-all duration-300 hover:border-bronze/40">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1 font-serifEn">SPECIAL GIFT</p>
      <p class="text-lg sm:text-xl font-serif text-charcoal tracking-wider">ご新規様 +10分延長</p>
      <p class="text-xs text-taupe mt-1 font-light">当サイトからのご予約特典</p>
    </div>
  </div>
</section>
