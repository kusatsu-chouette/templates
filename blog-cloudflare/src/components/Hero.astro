---
// templates/blog-cloudflare/src/components/Hero.astro

// ==========================================
// 【毎週の更新エリア】
// 日付が変わったら以下のテキストを書き換えて保存してください
// ==========================================
const lateNightDate = "11月3日(火)";
const lateNightHours = "8:00 — 27:00（深夜3時まで）";
const lateNightStatus = "ご予約受付中"; // 
const lateNightNote = "静まり返った夜の完全個室。一日のお疲れや緊張を、温かなロングストロークで解きほぐします。";
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 pt-6 pb-12">
  <!-- メインヒーローバナー -->
  <div class="relative rounded-3xl overflow-hidden shadow-lg border border-sand/40 bg-charcoal min-h-[480px] sm:min-h-0 sm:aspect-[16/9] lg:aspect-[2/1] flex flex-col justify-between p-5 sm:p-10">
    
    <!-- 背景写真 & グラデーションオーバーレイ -->
    <img 
      src="https://kusatsu-aroma.com/_emdash/api/media/file/01M63112AR4AJ7H9SMFBDYZDE8.01M6311348MM788S5PG8NN06NP.jpg" 
      alt="La Chouette 施術風景" 
      class="absolute inset-0 w-full h-full object-cover object-top sm:object-center z-0"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal/95 via-charcoal/60 to-charcoal/30 z-10"></div>

    <!-- 上部バッジエリア -->
    <div class="relative z-20 flex flex-wrap items-center justify-between gap-2.5 sm:gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-light tracking-wider bg-charcoal/60 backdrop-blur-md text-alabaster border border-white/10">
          ✦ 女性専用・完全個室サロン
        </span>
        <span class="inline-flex items-center px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-medium tracking-wider bg-bronze/90 backdrop-blur-md text-alabaster shadow-sm">
          ✦ 施術歴15年 男性セラピスト専任
        </span>
      </div>
      <span class="inline-flex items-center px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-light tracking-wider bg-charcoal/60 backdrop-blur-md text-alabaster border border-white/10">
        8:00 — 27:00
      </span>
    </div>

    <!-- 下部メインメッセージエリア -->
    <div class="relative z-20 max-w-2xl mt-auto pt-6 sm:pt-8">
      <!-- 新規特典バッジ -->
      <div class="mb-3">
        <span class="inline-block px-3 py-1 rounded-md text-xs font-medium bg-bronze text-alabaster tracking-wider shadow-sm">
          ✦ 当サイトからのご予約で【ご新規様 10分無料延長】
        </span>
      </div>

      <!-- 英語キャッチ -->
      <p class="text-xs sm:text-sm tracking-[0.2em] text-sand uppercase font-light mb-1">
        A Quiet Pause in Your Busy Days —
      </p>

      <!-- メイン見出し -->
      <h2 class="text-xl sm:text-3xl lg:text-4xl font-serif text-alabaster tracking-wider leading-snug mb-3">
        役割を脱ぎ捨て、<br />
        ただひとりの女性に還る「間 —」を。
      </h2>

      <!-- リード文 -->
      <p class="text-xs sm:text-sm text-sand/90 font-light leading-relaxed">
        誰にも気を使わない完全個室。施術歴15年のベテラン男性セラピストの大きな手による、密着感のある温かなロングストロークで深い非日常の癒やしへと導きます。
      </p>
    </div>
  </div>

  <!-- 近日の深夜営業日アナウンスバナー（毎週上部コードで日付更新） -->
  <div class="mt-4 rounded-2xl bg-gradient-to-r from-charcoal via-[#2A2624] to-charcoal border border-sand/40 p-5 sm:p-6 shadow-md text-alabaster relative overflow-hidden">
    <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-bronze/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-bronze animate-pulse"></span>
          <span class="text-[11px] tracking-[0.2em] uppercase text-sand font-medium">LATE NIGHT SCHEDULE</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] bg-bronze/80 text-alabaster font-light tracking-wide">
            {lateNightStatus}
          </span>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-lg sm:text-xl font-serif tracking-wider text-alabaster">
            次回深夜営業：<span class="text-bronze font-medium border-b border-bronze/40 pb-0.5">{lateNightDate}</span>
          </h3>
          <p class="text-xs sm:text-sm text-sand/80 font-light tracking-wide">
            受付時間：{lateNightHours}
          </p>
        </div>
        <p class="text-xs text-sand/70 font-light leading-relaxed max-w-2xl pt-1">
          {lateNightNote}
        </p>
      </div>

      <div class="flex items-center gap-3 pt-2 md:pt-0 shrink-0">
        <a 
          href="https://line.me/R/ti/p/@kusatsu-aroma" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-bronze hover:bg-[#78614C] text-alabaster text-xs tracking-wider transition-all duration-300 shadow-sm font-medium w-full md:w-auto text-center"
        >
          LINEで空き状況を確認
        </a>
      </div>
    </div>
  </div>

  <!-- 下部 特徴・案内カード（3カラム） -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
    <!-- カード1: 営業時間 -->
    <div class="bg-champagne/70 border border-sand/60 rounded-2xl p-5 text-center transition-all duration-300 hover:border-bronze/50">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1">OPEN HOURS</p>
      <p class="text-xl font-serif text-charcoal tracking-wider">8:00 — 27:00</p>
      <p class="text-xs text-taupe mt-1 font-light">朝〜深夜3時迄受付</p>
    </div>

    <!-- カード2: ベテラン男性セラピスト強調 -->
    <div class="bg-champagne/70 border border-sand/60 rounded-2xl p-5 text-center transition-all duration-300 hover:border-bronze/50">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1">THERAPIST</p>
      <p class="text-xl font-serif text-bronze tracking-wider font-medium">施術歴15年（男性）</p>
      <p class="text-xs text-taupe mt-1 font-light">包み込む大きな手と安心の個室</p>
    </div>

    <!-- カード3: 特典案内 -->
    <div class="bg-champagne/70 border border-sand/60 rounded-2xl p-5 text-center transition-all duration-300 hover:border-bronze/50">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1">SPECIAL GIFT</p>
      <p class="text-xl font-serif text-charcoal tracking-wider">+10分延長</p>
      <p class="text-xs text-taupe mt-1 font-light">当サイト新規予約特典</p>
    </div>
  </div>
</section>
