---
import LateNightBanner from './LateNightBanner.astro';

// リピーター様専用予約リンク設定
const squareBookingUrl = "https://app.squareup.com/appointments/book/fqk7s06sbwkojt/L7STD9CD9RRTC/start";
const lineBookingUrl = "https://lin.ee/nzuEONf"; // サロンの公式LINE友だち追加URL
const phoneTel = "tel:08062193290";
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 pt-6 pb-12">
  <!-- メインヒーローバナー -->
  <div class="relative rounded-3xl overflow-hidden shadow-lg border border-sand/40 bg-charcoal min-h-[440px] sm:min-h-0 sm:aspect-[16/9] lg:aspect-[2/1] flex flex-col justify-between p-5 sm:p-10">
    
    <!-- 背景動画 & フォールバック静止画 & グラデーションオーバーレイ -->
    <video
      autoplay
      muted
      loop
      playsinline
      poster="https://kusatsu-aroma.com/_emdash/api/media/file/01M63112AR4AJ7H9SMFBDYZDE8.01M6311348MM788S5PG8NN06NP.jpg"
      class="absolute inset-0 w-full h-full object-cover object-center z-0"
    >
      <source src="https://kusatsu-aroma.com/_emdash/api/media/file/01M6B9CSGT2N73Q5ZHEREDG9S4.01M6B9CTB8TKN1K098SB14N3RZ.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/50 to-charcoal/20 z-10"></div>

    <!-- 上部バッジエリア -->
    <div class="relative z-20 flex flex-wrap items-center justify-between gap-2.5 sm:gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-light tracking-wider bg-charcoal/60 backdrop-blur-md text-alabaster border border-white/10">
          ✦ 女性専用・完全個室サロン
        </span>
        <span class="inline-flex items-center px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-medium tracking-wider bg-bronze/90 backdrop-blur-md text-alabaster shadow-sm">
          ✦ 施術歴15年 男性セラピスト専任
        </span>
      </div>
      <span class="inline-flex items-center px-2.5 sm:px-3 py-1 rounded-full text-[11px] sm:text-xs font-light tracking-wider bg-charcoal/60 backdrop-blur-md text-alabaster border border-white/10">
        8:00 — 27:00
      </span>
    </div>

    <!-- 下部メインメッセージエリア -->
    <div class="relative z-20 max-w-2xl mt-auto pt-4 sm:pt-6">
      <!-- 英語キャッチ -->
      <p class="text-xs sm:text-sm tracking-[0.2em] text-sand uppercase font-light mb-1">
        A Quiet Pause in Your Busy Days —
      </p>

      <!-- メイン見出し -->
      <h2 class="text-xl sm:text-3xl lg:text-4xl font-serif text-alabaster tracking-wider leading-snug mb-2.5">
        役割を脱ぎ捨て、<br />
        ただひとりの女性に還る「間 —」を。
      </h2>

      <!-- リード文 -->
      <p class="text-xs sm:text-sm text-sand/90 font-light leading-relaxed">
        誰にも気を使わない完全個室。施術歴15年のベテラン男性セラピストの大きな手による、密着感のある温かなロングストロークで深い非日常の癒やしへと導きます。
      </p>
    </div>
  </div>

  <!-- リピーター様専用 クイック予約バー -->
  <div class="mt-4 rounded-2xl bg-champagne/80 border border-sand/70 p-4 sm:p-5 flex flex-col md:flex-row items-center justify-between gap-3 shadow-sm">
    <div class="flex items-center gap-3 text-center sm:text-left w-full md:w-auto justify-center sm:justify-start">
      <span class="w-8 h-8 rounded-full bg-bronze/15 text-bronze flex items-center justify-center shrink-0 text-sm font-serif">
        ✦
      </span>
      <div>
        <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light">FOR REPEAT CLIENTS</p>
        <h3 class="text-sm sm:text-base font-serif text-charcoal tracking-wide font-medium">
          リピーター様専用クイック予約
        </h3>
      </div>
    </div>
    
    <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full md:w-auto">
      <a
        href={squareBookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 sm:flex-none inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl bg-bronze hover:opacity-90 text-alabaster text-xs tracking-wider transition-all duration-300 shadow-sm font-medium whitespace-nowrap text-center"
      >
        WEB即時予約
      </a>
      <a
        href={lineBookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 sm:flex-none inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl bg-alabaster hover:bg-white text-charcoal border border-sand text-xs tracking-wider transition-all duration-300 shadow-sm font-medium whitespace-nowrap text-center"
      >
        公式LINE予約
      </a>
      <a
        href={phoneTel}
        class="flex-1 sm:flex-none inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl bg-alabaster hover:bg-white text-charcoal border border-sand text-xs tracking-wider transition-all duration-300 shadow-sm font-medium whitespace-nowrap text-center"
      >
        お電話予約
      </a>
    </div>
  </div>

  <!-- 近日の深夜営業日アナウンスバナー（独立コンポーネント配置） -->
  <div class="mt-4">
    <LateNightBanner />
  </div>

  <!-- 下部 特徴・案内カード（3カラム） -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
    <!-- カード1: 営業時間 -->
    <div class="bg-champagne/70 border border-sand/60 rounded-2xl p-5 text-center transition-all duration-300 hover:border-bronze/50">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1">OPEN HOURS</p>
      <p class="text-xl font-serif text-charcoal tracking-wider">8:00 — 27:00</p>
      <p class="text-xs text-taupe mt-1 font-light">朝〜深夜3時迄受付</p>
    </div>

    <!-- カード2: ベテラン男性セラピスト強調 -->
    <div class="bg-champagne/70 border border-sand/60 rounded-2xl p-5 text-center transition-all duration-300 hover:border-bronze/50">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1">THERAPIST</p>
      <p class="text-xl font-serif text-bronze tracking-wider font-medium">施術歴15年（男性）</p>
      <p class="text-xs text-taupe mt-1 font-light">包み込む大きな手と安心の個室</p>
    </div>

    <!-- カード3: 特典案内 -->
    <div class="bg-champagne/70 border border-sand/60 rounded-2xl p-5 text-center transition-all duration-300 hover:border-bronze/50">
      <p class="text-[10px] tracking-[0.2em] text-taupe uppercase font-light mb-1">SPECIAL GIFT</p>
      <p class="text-xl font-serif text-charcoal tracking-wider">+10分延長</p>
      <p class="text-xs text-taupe mt-1 font-light">当サイト新規予約特典</p>
    </div>
  </div>
</section>
