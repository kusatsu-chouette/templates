---
// src/components/Simulator.astro
---

<section id="simulator" class="py-16 sm:py-24 px-4 sm:px-6 bg-champagne/40 border-b border-sand/70">
  <div class="max-w-xl lg:max-w-3xl mx-auto space-y-8">
    <div class="text-center space-y-2">
      <p class="text-xs tracking-[0.28em] text-bronze uppercase">
        05 — COURSE FINDER
      </p>
      <h2 class="text-[22px] sm:text-3xl text-charcoal font-serif">
        今日のあなたへの「おすすめコース診断」
      </h2>
      <p class="text-xs text-taupe">
        ご気分とお好みに合わせて、最適なコースとご予約枠をご案内します。
      </p>
    </div>

    <div class="bg-white rounded-3xl border border-sand p-5 sm:p-8 shadow-sm space-y-6">
      <!-- STEP 1: 気分・希望 -->
      <div class="space-y-2">
        <p class="text-xs font-medium text-bronze tracking-wider">
          STEP 1 — 今の気分・ご希望に近いものは？
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button type="button" onclick="setSimValue('concern', '日常を忘れてとことん癒やされたい', this)" class="sim-btn sim-concern text-left p-3 rounded-xl border border-bronze bg-champagne/70 transition-all">
            <p class="text-xs sm:text-sm font-medium text-charcoal">日常を忘れてとことん癒やされたい</p>
            <p class="text-[10px] text-taupe mt-0.5">全身くまなくロングストロークで包まれたい</p>
          </button>
          <button type="button" onclick="setSimValue('concern', '全身の疲れをバランスよく流したい', this)" class="sim-btn sim-concern text-left p-3 rounded-xl border border-sand hover:border-bronze/60 transition-all">
            <p class="text-xs sm:text-sm font-medium text-charcoal">全身の疲れをバランスよく流したい</p>
            <p class="text-[10px] text-taupe mt-0.5">首肩から脚先まで心地よくリフレッシュしたい</p>
          </button>
          <button type="button" onclick="setSimValue('concern', '頭を空っぽにして深くまどろみたい', this)" class="sim-btn sim-concern text-left p-3 rounded-xl border border-sand hover:border-bronze/60 transition-all">
            <p class="text-xs sm:text-sm font-medium text-charcoal">頭を空っぽにして深くまどろみたい</p>
            <p class="text-[10px] text-taupe mt-0.5">温かい手のぬくもりで静かに休息したい</p>
          </button>
          <button type="button" onclick="setSimValue('concern', 'まずは気軽に体験してみたい', this)" class="sim-btn sim-concern text-left p-3 rounded-xl border border-sand hover:border-bronze/60 transition-all">
            <p class="text-xs sm:text-sm font-medium text-charcoal">まずは気軽に体験してみたい</p>
            <p class="text-[10px] text-taupe mt-0.5">男性セラピストが初めて・短時間で癒やされたい</p>
          </button>
        </div>
      </div>

      <!-- STEP 2: タッチ・圧 -->
      <div class="space-y-2">
        <p class="text-xs font-medium text-bronze tracking-wider">
          STEP 2 — お好みのタッチ・圧の強さは？
        </p>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" onclick="setSimValue('pressure', 'しっかり密着圧', this)" class="sim-btn sim-pressure py-2.5 px-2 rounded-xl border border-bronze bg-champagne/70 text-xs text-center transition-all">
            しっかり密着圧
          </button>
          <button type="button" onclick="setSimValue('pressure', '心地よい中圧', this)" class="sim-btn sim-pressure py-2.5 px-2 rounded-xl border border-sand text-xs text-center transition-all">
            心地よい中圧
          </button>
          <button type="button" onclick="setSimValue('pressure', '優しいロングストローク', this)" class="sim-btn sim-pressure py-2.5 px-2 rounded-xl border border-sand text-xs text-center transition-all">
            優しいタッチ
          </button>
        </div>
      </div>

      <!-- STEP 3: 時間帯 -->
      <div class="space-y-2">
        <p class="text-xs font-medium text-bronze tracking-wider">
          STEP 3 — ご希望の時間帯は？（8:00〜27:00）
        </p>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" onclick="setSimValue('timeband', '朝・午前（8:00—12:00）', this)" class="sim-btn sim-time py-2 px-2 rounded-xl border border-sand text-center transition-all">
            <span class="block text-xs font-semibold text-bronze">8:00—12:00</span>
            <span class="text-[10px] text-taupe">朝・午前</span>
          </button>
          <button type="button" onclick="setSimValue('timeband', '日中（12:00—19:00）', this)" class="sim-btn sim-time py-2 px-2 rounded-xl border border-bronze bg-champagne/70 text-center transition-all">
            <span class="block text-xs font-semibold text-bronze">12:00—19:00</span>
            <span class="text-[10px] text-taupe">日中</span>
          </button>
          <button type="button" onclick="setSimValue('timeband', '夜・深夜（19:00—27:00）', this)" class="sim-btn sim-time py-2 px-2 rounded-xl border border-sand text-center transition-all">
            <span class="block text-xs font-semibold text-bronze">19:00—27:00</span>
            <span class="text-[10px] text-taupe">夜・深夜</span>
          </button>
        </div>
      </div>

      <!-- STEP 4: ご希望日とお名前 -->
      <div class="space-y-2 pt-2 border-t border-sand/50">
        <p class="text-xs font-medium text-bronze tracking-wider">
          STEP 4 — ご希望の日程とお名前
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] text-taupe mb-1">ご希望日</label>
            <input 
              type="date" 
              id="simDateInput" 
              class="w-full px-3 py-2.5 rounded-xl border border-sand text-xs text-charcoal bg-alabaster/50 focus:outline-none focus:border-bronze"
            />
          </div>
          <div>
            <label class="block text-[11px] text-taupe mb-1">お名前（ニックネーム可）</label>
            <input 
              type="text" 
              id="simNameInput" 
              placeholder="例：山田" 
              class="w-full px-3 py-2.5 rounded-xl border border-sand text-xs text-charcoal bg-alabaster/50 focus:outline-none focus:border-bronze"
            />
          </div>
        </div>
      </div>

      <!-- 診断結果表示と予約アクション -->
      <div class="bg-alabaster rounded-2xl border border-bronze/40 p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-sand pb-2">
          <span class="text-[10px] tracking-[0.2em] text-bronze font-serif">RECOMMENDED COURSE</span>
          <span id="simBadge" class="text-[10px] px-2.5 py-0.5 rounded-full bg-bronze text-white">一番人気・贅沢ケア</span>
        </div>

        <div>
          <h3 id="simCourseTitle" class="text-base sm:text-lg font-serif text-charcoal">
            アロマオイルトリートメント 120分
          </h3>
          <p class="text-xl sm:text-2xl text-bronze mt-0.5 font-serif">
            <span id="simCoursePrice">¥8,970</span>
            <span id="simCourseBenefit" class="text-xs text-taupe font-sans ml-1">（ご新規様特典：+10分無料延長）</span>
          </p>
        </div>

        <!-- LINE自動予約ボタン -->
        <button 
          type="button" 
          onclick="sendToLineReservation()" 
          class="w-full py-3.5 px-4 rounded-full bg-[#06C755] hover:bg-[#05b34c] text-white text-xs font-medium tracking-wider flex items-center justify-center gap-2 shadow-sm transition-all"
        >
          <span>公式LINEでこの内容の空き状況を確認・予約する</span>
          <span>→</span>
        </button>

        <p class="text-[10px] text-center text-taupe">
          ※タップすると公式LINEが開き、選択したご希望日時とコース内容がメッセージ欄に自動入力されます。
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  var simData = {
    concern: '日常を忘れてとことん癒やされたい',
    pressure: 'しっかり密着圧',
    timeband: '日中（12:00—19:00）',
    course: 'アロマオイルトリートメント 120分',
    price: '¥8,970'
  };

  document.addEventListener('DOMContentLoaded', function() {
    var dateInput = document.getElementById('simDateInput');
    if (dateInput) {
      var today = new Date().toISOString().split('T')[0];
      dateInput.value = today;
      dateInput.min = today;
    }
  });

  function setSimValue(type, value, btnEl) {
    simData[type] = value;
    
    var parent = btnEl.parentElement;
    var buttons = parent.querySelectorAll('.sim-btn');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].classList.remove('border-bronze', 'bg-champagne/70');
      buttons[i].classList.add('border-sand');
    }
    btnEl.classList.remove('border-sand');
    btnEl.classList.add('border-bronze', 'bg-champagne/70');

    updateCourseRecommendation();
  }

  function updateCourseRecommendation() {
    var titleEl = document.getElementById('simCourseTitle');
    var priceEl = document.getElementById('simCoursePrice');
    var badgeEl = document.getElementById('simBadge');

    if (simData.concern.indexOf('気軽に体験') !== -1) {
      simData.course = 'アロマオイルトリートメント 60分';
      simData.price = '¥5,980';
      if (badgeEl) badgeEl.textContent = '気軽にお試し';
    } else if (simData.concern.indexOf('バランスよく') !== -1) {
      simData.course = 'アロマオイルトリートメント 90分';
      simData.price = '¥7,480';
      if (badgeEl) badgeEl.textContent = '定番・全身ケア';
    } else {
      simData.course = 'アロマオイルトリートメント 120分';
      simData.price = '¥8,970';
      if (badgeEl) badgeEl.textContent = '一番人気・贅沢ケア';
    }

    if (titleEl) titleEl.textContent = simData.course;
    if (priceEl) priceEl.textContent = simData.price;
  }

  function sendToLineReservation() {
    var dateInput = document.getElementById('simDateInput');
    var nameInput = document.getElementById('simNameInput');

    var selectedDate = (dateInput && dateInput.value) ? dateInput.value : '未指定（相談希望）';
    var rawName = (nameInput && nameInput.value) ? nameInput.value.trim() : '';
    var clientName = rawName ? rawName + ' 様' : '（お名前未記入）';

    var lines = [
      '【おすすめコース診断からのご予約希望】',
      '--------------------------------',
      '・お名前：' + clientName,
      '・ご希望日：' + selectedDate,
      '・希望時間帯：' + simData.timeband,
      '・ご希望コース：' + simData.course + '（' + simData.price + '）',
      '・お好みの圧：' + simData.pressure,
      '・お悩み・気分：' + simData.concern,
      '--------------------------------',
      '上記の内容で空き状況の確認をお願いいたします。'
    ];

    var msg = lines.join('\n');
    var lineUrl = 'https://line.me/R/oaMessage/@nzuEONf/?' + encodeURIComponent(msg);
    window.open(lineUrl, '_blank');
  }
</script>
