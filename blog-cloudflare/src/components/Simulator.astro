---
// templates/blog-cloudflare/src/components/Simulator.astro
// 女性専用サロン La Chouette（ラ・シュエット）コース診断・事前ヒアリングコンポーネント
---

<section id="simulator" class="py-16 md:py-24 bg-[#EDE7DF] border-t border-b border-[#DCD3C6]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- セクション見出し -->
    <div class="text-center mb-10 md:mb-12">
      <span class="text-xs md:text-sm uppercase tracking-widest text-[#8E735B] font-semibold block mb-2">COURSE SIMULATOR</span>
      <h2 class="text-2xl md:text-3xl font-serif text-[#221F1D] mb-4">今のあなたにぴったりの癒やしをご提案</h2>
      <p class="text-sm md:text-base text-[#7D7571] max-w-xl mx-auto leading-relaxed">
        お体の状態や気分、ご希望の過ごし方をお選びください。<br class="hidden sm:inline">
        診断結果をそのままLINEで送信いただくと、日程調整のやり取りもスムーズにご案内できます。
      </p>
    </div>

    <!-- 診断フォーム -->
    <form id="simulator-form" class="bg-[#F7F4EF] p-6 sm:p-8 md:p-10 rounded-2xl shadow-sm border border-[#DCD3C6] space-y-8">
      
      <!-- 設問1: お悩み・気分 -->
      <div>
        <label class="block text-sm sm:text-base font-semibold text-[#221F1D] mb-3">
          1. 今一番気になるお体の状態や気分は？ <span class="text-xs text-[#8E735B] font-normal ml-2">※必須</span>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label class="relative block cursor-pointer">
            <input type="radio" name="mood" value="fatigue" class="peer sr-only" checked />
            <div class="p-4 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-sm text-[#221F1D] block mb-1">全身の疲労回復</span>
              <span class="text-xs text-[#7D7571] block">蓄積しただるさを全身くまなくリセットしたい</span>
            </div>
          </label>
          <label class="relative block cursor-pointer">
            <input type="radio" name="mood" value="stiff" class="peer sr-only" />
            <div class="p-4 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-sm text-[#221F1D] block mb-1">首・肩こり・背中の張り</span>
              <span class="text-xs text-[#7D7571] block">上半身の重さ・肩甲骨まわりを重点的にほぐしたい</span>
            </div>
          </label>
          <label class="relative block cursor-pointer">
            <input type="radio" name="mood" value="swelling" class="peer sr-only" />
            <div class="p-4 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-sm text-[#221F1D] block mb-1">脚のむくみ・冷え</span>
              <span class="text-xs text-[#7D7571] block">立ち仕事や座りっぱなしで滞った下半身を流したい</span>
            </div>
          </label>
          <label class="relative block cursor-pointer">
            <input type="radio" name="mood" value="deep_relax" class="peer sr-only" />
            <div class="p-4 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-sm text-[#221F1D] block mb-1">至福の休息・ストレス解放</span>
              <span class="text-xs text-[#7D7571] block">時間を忘れて深くリラックスし、贅沢に癒やされたい</span>
            </div>
          </label>
        </div>
      </div>

      <!-- 設問2: 好みの圧 -->
      <div>
        <label class="block text-sm sm:text-base font-semibold text-[#221F1D] mb-3">
          2. お好みの圧加減は？ <span class="text-xs text-[#8E735B] font-normal ml-2">※必須</span>
        </label>
        <div class="grid grid-cols-3 gap-3">
          <label class="relative block cursor-pointer text-center">
            <input type="radio" name="pressure" value="soft" class="peer sr-only" />
            <div class="py-3 px-2 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-xs sm:text-sm text-[#221F1D] block">やさしめ</span>
              <span class="text-[11px] text-[#7D7571] block mt-0.5">ソフトなタッチ</span>
            </div>
          </label>
          <label class="relative block cursor-pointer text-center">
            <input type="radio" name="pressure" value="medium" class="peer sr-only" checked />
            <div class="py-3 px-2 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-xs sm:text-sm text-[#221F1D] block">ふつう</span>
              <span class="text-[11px] text-[#7D7571] block mt-0.5">心地よい標準圧</span>
            </div>
          </label>
          <label class="relative block cursor-pointer text-center">
            <input type="radio" name="pressure" value="firm" class="peer sr-only" />
            <div class="py-3 px-2 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-xs sm:text-sm text-[#221F1D] block">しっかりめ</span>
              <span class="text-[11px] text-[#7D7571] block mt-0.5">深層まで届く圧</span>
            </div>
          </label>
        </div>
      </div>

      <!-- 設問3: 希望時間帯 -->
      <div>
        <label class="block text-sm sm:text-base font-semibold text-[#221F1D] mb-3">
          3. ご希望の時間帯は？ <span class="text-xs text-[#8E735B] font-normal ml-2">※必須（8:00〜27:00営業）</span>
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          <label class="relative block cursor-pointer text-center">
            <input type="radio" name="timezone" value="morning" class="peer sr-only" />
            <div class="p-3 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-xs sm:text-sm text-[#221F1D] block">午前</span>
              <span class="text-[11px] text-[#7D7571] block mt-0.5">8:00〜12:00</span>
            </div>
          </label>
          <label class="relative block cursor-pointer text-center">
            <input type="radio" name="timezone" value="afternoon" class="peer sr-only" checked />
            <div class="p-3 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-xs sm:text-sm text-[#221F1D] block">午後</span>
              <span class="text-[11px] text-[#7D7571] block mt-0.5">12:00〜17:00</span>
            </div>
          </label>
          <label class="relative block cursor-pointer text-center">
            <input type="radio" name="timezone" value="evening" class="peer sr-only" />
            <div class="p-3 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-xs sm:text-sm text-[#221F1D] block">夜間</span>
              <span class="text-[11px] text-[#7D7571] block mt-0.5">17:00〜21:00</span>
            </div>
          </label>
          <label class="relative block cursor-pointer text-center">
            <input type="radio" name="timezone" value="night" class="peer sr-only" />
            <div class="p-3 rounded-xl border border-[#DCD3C6] bg-white transition-all peer-checked:border-[#8E735B] peer-checked:bg-[#EDE7DF] peer-checked:ring-1 peer-checked:ring-[#8E735B] hover:border-[#8E735B]/50">
              <span class="font-medium text-xs sm:text-sm text-[#221F1D] block">深夜</span>
              <span class="text-[11px] text-[#7D7571] block mt-0.5">21:00〜27:00</span>
            </div>
          </label>
        </div>
      </div>

      <!-- 設問4 & 5: 事前情報（日程往復ゼロ化） -->
      <div class="pt-2 border-t border-[#DCD3C6]/60 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="sim-date" class="block text-xs sm:text-sm font-semibold text-[#221F1D] mb-1.5">
            ご希望日 <span class="text-xs text-[#7D7571] font-normal">（任意・複数可）</span>
          </label>
          <input 
            type="text" 
            id="sim-date" 
            placeholder="例：今週末、11月10日など" 
            class="w-full text-sm rounded-xl border border-[#DCD3C6] bg-white px-3.5 py-2.5 text-[#221F1D] placeholder-[#7D7571]/60 focus:border-[#8E735B] focus:outline-none focus:ring-1 focus:ring-[#8E735B]"
          />
        </div>
        <div>
          <label for="sim-name" class="block text-xs sm:text-sm font-semibold text-[#221F1D] mb-1.5">
            お名前 <span class="text-xs text-[#7D7571] font-normal">（名字やニックネーム可）</span>
          </label>
          <input 
            type="text" 
            id="sim-name" 
            placeholder="例：山田" 
            class="w-full text-sm rounded-xl border border-[#DCD3C6] bg-white px-3.5 py-2.5 text-[#221F1D] placeholder-[#7D7571]/60 focus:border-[#8E735B] focus:outline-none focus:ring-1 focus:ring-[#8E735B]"
          />
        </div>
      </div>

      <!-- 診断ボタン -->
      <div class="pt-4 text-center">
        <button 
          type="submit" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-3.5 rounded-full bg-[#8E735B] text-white text-sm sm:text-base font-medium tracking-wide shadow hover:bg-[#78614C] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#8E735B]"
        >
          診断結果を見る
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>

    </form>

    <!-- 診断結果表示枠（初期状態は hidden） -->
    <div id="simulator-result" class="hidden mt-10 bg-[#F7F4EF] p-6 sm:p-8 md:p-10 rounded-2xl shadow-md border-2 border-[#8E735B]/40">
      
      <div class="text-center mb-6">
        <span class="inline-block px-3 py-1 rounded-full bg-[#8E735B]/15 text-[#8E735B] text-xs font-semibold tracking-wider mb-2">DIAGNOSIS RESULT</span>
        <h3 class="text-xl sm:text-2xl font-serif text-[#221F1D]">あなたへのおすすめコース</h3>
      </div>

      <!-- 結果カード -->
      <div class="bg-white p-5 sm:p-6 rounded-xl border border-[#DCD3C6] mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#DCD3C6] gap-2">
          <h4 id="result-course-title" class="text-base sm:text-lg font-bold text-[#221F1D]"></h4>
          <span id="result-course-time" class="inline-block px-3 py-1 bg-[#EDE7DF] text-[#8E735B] text-xs font-semibold rounded-full self-start sm:self-auto"></span>
        </div>
        <p id="result-course-desc" class="text-xs sm:text-sm text-[#7D7571] leading-relaxed mt-4"></p>
        
        <!-- 選択サマリー -->
        <div class="mt-4 pt-3 border-t border-dashed border-[#DCD3C6] grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs text-[#7D7571]">
          <div>好みの圧：<span id="result-summary-pressure" class="text-[#221F1D] font-medium"></span></div>
          <div>希望時間帯：<span id="result-summary-timezone" class="text-[#221F1D] font-medium"></span></div>
          <div>希望日：<span id="result-summary-date" class="text-[#221F1D] font-medium"></span></div>
        </div>
      </div>

      <!-- LINE送信 & Square予約 アクションエリア -->
      <div class="space-y-3 sm:space-y-4">
        
        <!-- LINE連携ボタン（正規LINE ID @937gxodo 連携） -->
        <a 
          id="result-line-btn" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full flex items-center justify-center px-6 py-3.5 rounded-full bg-[#06C755] hover:bg-[#05b34c] text-white font-medium text-sm sm:text-base shadow transition-colors"
        >
          <svg class="w-5 h-5 mr-2.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 5.82 2 10.53c0 2.93 1.77 5.51 4.47 7.02-.19.67-.69 2.45-.79 2.82-.12.46.17.45.36.33.15-.09 2.05-1.39 2.88-1.95.35.05.71.08 1.08.08 5.52 0 10-3.82 10-8.53S17.52 2 12 2z"/>
          </svg>
          診断内容をLINEに送って空き枠を相談する
        </a>
        <p class="text-center text-xs text-[#7D7571]">
          ※上のボタンを押すと、選択した内容が自動入力された状態で公式LINEが開きます。
        </p>

        <!-- Square WEB予約ボタン -->
        <div class="pt-2 text-center">
          <a 
            href="https://app.squareup.com/appointments/book/fqk7s06sbwkojt/L7STD9CD9RRTC/start" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-block text-xs sm:text-sm text-[#8E735B] underline hover:text-[#78614C] transition-colors"
          >
            日時をカレンダーから選んですぐ予約したい方はこちら（Square予約）
          </a>
        </div>

        <!-- 再診断ボタン -->
        <div class="pt-2 text-center">
          <button 
            type="button" 
            id="simulator-reset-btn" 
            class="text-xs text-[#7D7571] hover:text-[#221F1D] underline"
          >
            もう一度選び直す
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('simulator-form');
    var resultArea = document.getElementById('simulator-result');
    var courseTitleEl = document.getElementById('result-course-title');
    var courseDescEl = document.getElementById('result-course-desc');
    var courseTimeEl = document.getElementById('result-course-time');
    var summaryPressureEl = document.getElementById('result-summary-pressure');
    var summaryTimezoneEl = document.getElementById('result-summary-timezone');
    var summaryDateEl = document.getElementById('result-summary-date');
    var lineBtn = document.getElementById('result-line-btn');
    var resetBtn = document.getElementById('simulator-reset-btn');

    if (!form || !resultArea) return;

    var courseData = {
      fatigue: {
        title: '【人気No.1】全身アロマトリートメント 90分コース',
        time: '90分',
        desc: '蓄積した全身の疲労やだるさを、足先からデコルテまでくまなく解きほぐす定番の人気コースです。全体の巡りを整え、心身ともに深い軽やかさを取り戻します。'
      },
      stiff: {
        title: '【部位集中】首・肩・背中集中トリートメント 60分コース',
        time: '60分',
        desc: 'デスクワークや家事で凝り固まった上半身を集中的にケア。肩甲骨まわりや首筋のこわばりを丁寧に緩め、呼吸がふっと深くなるような解放感を届けます。'
      },
      swelling: {
        title: '【部位集中】脚のむくみ・冷え集中トリートメント 60分コース',
        time: '60分',
        desc: '滞りがちな下半身の巡りを重点的に促進。足裏からふくらはぎ、太ももまで丁寧に流し、帰りは靴がすっと履けるような軽快さを目指します。'
      },
      deep_relax: {
        title: '【極上の休息】ディープリフレッシュ フルボディ 120分コース',
        time: '120分',
        desc: '頭から足先まで、日常の緊張を忘れてゆったりと身を委ねる極上コース。プレッシャーやストレスから心身を解放し、上質な眠りへと誘う深い癒やしをご堪能ください。'
      }
    };

    var pressureLabels = {
      soft: 'やさしめ（ソフトな癒やし）',
      medium: 'ふつう（心地よい適度な圧）',
      firm: 'しっかりめ（深層まで届く圧）'
    };

    var timezoneLabels = {
      morning: '午前（8:00〜12:00）',
      afternoon: '午後（12:00〜17:00）',
      evening: '夜間（17:00〜21:00）',
      night: '深夜（21:00〜27:00）'
    };

    var moodLabels = {
      fatigue: '全身の疲労・だるさをリセットしたい',
      stiff: '首・肩こりや背中の張りをほぐしたい',
      swelling: '脚のむくみ・冷えを解消したい',
      deep_relax: '贅沢に深く癒やされたい（不眠・ストレス）'
    };

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var moodRadio = form.querySelector('input[name="mood"]:checked');
      var pressureRadio = form.querySelector('input[name="pressure"]:checked');
      var timezoneRadio = form.querySelector('input[name="timezone"]:checked');
      var nameInput = document.getElementById('sim-name');
      var dateInput = document.getElementById('sim-date');

      var moodVal = moodRadio ? moodRadio.value : 'fatigue';
      var pressureVal = pressureRadio ? pressureRadio.value : 'medium';
      var timezoneVal = timezoneRadio ? timezoneRadio.value : 'afternoon';
      var nameVal = nameInput && nameInput.value.trim() ? nameInput.value.trim() : '未記入';
      var dateVal = dateInput && dateInput.value.trim() ? dateInput.value.trim() : '日程相談希望';

      var course = courseData[moodVal] || courseData.fatigue;
      var pressureText = pressureLabels[pressureVal] || 'ふつう';
      var timezoneText = timezoneLabels[timezoneVal] || '午後';
      var moodText = moodLabels[moodVal] || '全身疲労';

      courseTitleEl.textContent = course.title;
      courseDescEl.textContent = course.desc;
      courseTimeEl.textContent = '目安時間：' + course.time;
      summaryPressureEl.textContent = pressureText;
      summaryTimezoneEl.textContent = timezoneText;
      summaryDateEl.textContent = dateVal;

      var lineMessage = '【ラ・シュエット コース診断・予約相談】\n' +
        '・お名前：' + nameVal + '\n' +
        '・ご希望日：' + dateVal + '\n' +
        '・希望時間帯：' + timezoneText + '\n' +
        '・お悩み・気分：' + moodText + '\n' +
        '・好みの圧：' + pressureText + '\n' +
        '・診断結果コース：' + course.title + '\n\n' +
        'こちらの内容で空き状況やご予約の相談をお願いします。';

      var lineUrl = 'https://line.me/R/oaMessage/@937gxodo/?' + encodeURIComponent(lineMessage);
      lineBtn.setAttribute('href', lineUrl);

      resultArea.classList.remove('hidden');
      resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        resultArea.classList.add('hidden');
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  });
</script>
