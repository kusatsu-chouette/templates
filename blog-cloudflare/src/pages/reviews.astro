          <p class="text-2xl md:text-3xl font-serif font-bold text-bronze">4.97<span class="text-xs text-taupe font-normal ml-1">/ 5.0</span></p>
        </div>
        <div class="bg-champagne p-4 rounded-xl border border-sand text-center">
          <p class="text-xs text-taupe mb-1">男性セラピストの安心感</p>
          <p class="text-xl md:text-2xl font-serif font-bold text-charcoal">100<span class="text-xs text-taupe font-normal ml-0.5">%</span></p>
        </div>
        <div class="bg-champagne p-4 rounded-xl border border-sand text-center">
          <p class="text-xs text-taupe mb-1">掲載クチコミ数</p>
          <p class="text-2xl md:text-3xl font-serif font-bold text-charcoal">34<span class="text-xs text-taupe font-normal ml-1">件</span></p>
        </div>
        <div class="bg-champagne p-4 rounded-xl border border-sand text-center">
          <p class="text-xs text-taupe mb-1">主なご利用年代</p>
          <p class="text-xl md:text-2xl font-serif font-bold text-charcoal">20〜60<span class="text-xs text-taupe font-normal ml-0.5">代</span></p>
        </div>
      </div>
    </section>

    <!-- クチコミカード一覧 -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {reviews.map((review) => (
          <article class="bg-champagne/80 hover:bg-champagne transition-all duration-300 rounded-2xl p-6 sm:p-7 border border-sand flex flex-col justify-between shadow-sm hover:shadow-md">
            <div>
              <!-- 投稿者ヘッダー -->
              <div class="flex items-start justify-between gap-4 border-b border-sand pb-4 mb-4">
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="font-bold text-base sm:text-lg text-charcoal font-serif">{review.name} 様</h3>
                    <span class="text-xs text-taupe bg-alabaster px-2.5 py-0.5 rounded-full border border-sand">
                      {review.reviewerInfo}
                    </span>
                  </div>
                  <!-- 星評価 -->
                  <div class="flex items-center gap-1.5 mt-2">
                    <div class="flex text-bronze text-sm">
                      {Array.from({ length: 5 }).map((_, i) => (
                        <span>{i < review.rating ? '★' : '☆'}</span>
                      ))}
                    </div>
                    <span class="text-xs font-bold text-bronze ml-1">5点満点中 {review.rating}.0</span>
                  </div>
                </div>

                <!-- 原本画像モーダル起動ボタン -->
                {review.imageUrl && (
                  <button
                    type="button"
                    class="view-evidence-btn inline-flex items-center gap-1 text-xs text-bronze hover:text-[#78614C] bg-alabaster hover:bg-sand/40 border border-sand px-3 py-1.5 rounded-lg transition-colors font-medium flex-shrink-0"
                    data-image-src={review.imageUrl}
                    data-reviewer={review.name}
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    原本画像
                  </button>
                )}
              </div>

              <!-- サブ評価内訳 -->
              <div class="text-[11px] sm:text-xs text-taupe mb-3 tracking-tight">
                {review.subRatings}
              </div>

              <!-- メニュー名 -->
              <div class="mb-4 bg-alabaster/70 p-2.5 rounded-lg border border-sand/60">
                <span class="text-[11px] text-bronze font-semibold block mb-0.5">ご利用コース</span>
                <p class="text-xs text-charcoal font-medium truncate">{review.menu}</p>
              </div>

              <!-- クチコミ本文 -->
              <div class="text-charcoal/90 text-sm leading-relaxed whitespace-pre-line font-sans">
                {review.content}
              </div>
            </div>

            <!-- タグ -->
            <div class="mt-6 pt-4 border-t border-sand/60 flex flex-wrap gap-1.5">
              {review.tags.map((tag) => (
                <span class="text-[11px] text-taupe bg-alabaster px-2 py-0.5 rounded border border-sand/50">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 安心と約束のセクション -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-20">
      <div class="bg-champagne rounded-3xl p-8 sm:p-10 border border-sand text-center">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-charcoal mb-4">
          初めての女性にも安心していただくために
        </h2>
        <p class="text-taupe text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-8">
          男性セラピストならではの「大きく温かい手のぬくもり」と「しっかりとした圧」をご実感いただきながら、不安なく施術をお受けいただけるよう、細心の配慮と丁寧なコミュニケーションをお約束します。
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left mb-8">
          <div class="bg-alabaster p-5 rounded-2xl border border-sand">
            <h4 class="font-bold text-sm text-charcoal mb-2 font-serif flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-bronze inline-block"></span>
              施術範囲の事前確認
            </h4>
            <p class="text-xs text-taupe leading-relaxed">
              触れてほしくない箇所や力加減のご要望を事前に細かく伺い、無理な施術は一切行いません。
            </p>
          </div>
          <div class="bg-alabaster p-5 rounded-2xl border border-sand">
            <h4 class="font-bold text-sm text-charcoal mb-2 font-serif flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-bronze inline-block"></span>
              徹底したタオルワーク
            </h4>
            <p class="text-xs text-taupe leading-relaxed">
              露出を最小限に抑える細やかなタオルさばきで、寒さや恥ずかしさを感じさせない環境を徹底します。
            </p>
          </div>
          <div class="bg-alabaster p-5 rounded-2xl border border-sand">
            <h4 class="font-bold text-sm text-charcoal mb-2 font-serif flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-bronze inline-block"></span>
              完全個室・プライベート
            </h4>
            <p class="text-xs text-taupe leading-relaxed">
              他のお客様と顔を合わせることのない静かなプライベート空間で、心身ともに心ゆくまでおくつろぎいただけます。
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://line.me"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-bronze text-white font-medium text-sm hover:bg-[#78614C] transition-colors shadow-sm"
          >
            公式LINEで予約・お問い合わせ
          </a>
          <a
            href="tel:080-6219-3290"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-alabaster text-charcoal border border-sand font-medium text-sm hover:bg-sand/30 transition-colors"
          >
            お電話でのお問い合わせ
          </a>
        </div>
      </div>
    </section>

    <!-- 原本画像プレビュー用モーダル -->
    <div id="imageModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
      <div class="relative bg-alabaster rounded-2xl max-w-2xl w-full max-h-[90vh] flex flex-col overflow-hidden border border-sand shadow-2xl">
        <div class="p-4 border-b border-sand flex items-center justify-between bg-champagne">
          <h4 id="modalReviewerName" class="font-serif font-bold text-charcoal text-sm sm:text-base">
            口コミ投稿原本
          </h4>
          <button id="closeModalBtn" type="button" class="text-taupe hover:text-charcoal p-1 rounded-lg transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="p-4 overflow-y-auto flex items-center justify-center bg-white/40">
          <img id="modalImage" src="" alt="口コミ投稿の原本画像" class="max-w-full h-auto object-contain rounded-lg border border-sand shadow-inner" />
        </div>
      </div>
    </div>
  </main>

  <!-- 共通フッター -->
  <Footer />

  <!-- モーダル制御スクリプト with is:inline (CRITICAL) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('imageModal');
      const modalImage = document.getElementById('modalImage');
      const modalReviewerName = document.getElementById('modalReviewerName');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const viewButtons = document.querySelectorAll('.view-evidence-btn');

      function openModal(src, reviewer) {
        if (!modal || !modalImage || !modalReviewerName) return;
        modalImage.src = src;
        modalReviewerName.textContent = `${reviewer} 様の口コミ原本`;
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      }

      function closeModal() {
        if (!modal || !modalImage) return;
        modal.classList.add('hidden');
        modalImage.src = '';
        document.body.classList.remove('overflow-hidden');
      }

      viewButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const src = btn.getAttribute('data-image-src');
          const reviewer = btn.getAttribute('data-reviewer');
          if (src) openModal(src, reviewer);
        });
      });

      if (closeModalBtn) {
        closeModalBtn.addEventListener('click', closeModal);
      }

      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });
    });
  </script>
</body>
</html>
