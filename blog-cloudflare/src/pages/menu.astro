---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// サロン施術メニュー（各コース専用画像）
const salonMenus = [
  {
    name: "スタンダード オイルトリートメント",
    duration: "90分",
    price: "¥6,630",
    description: "日常の緊張を解きほぐし、全身をゆったりとケアする標準的なリラクゼーションコースです。私がお一人おひとりの状態に合わせて丁寧に施術いたします。",
    image: "https://kusatsu-aroma.com/_emdash/api/media/file/01M6ATQMYVQBR0Q82M9J26Z8FJ.01M6ATQNKNPPXCSD126G272X6X.jpg",
    recommend: true,
  },
  {
    name: "プレミアム オイルトリートメント",
    duration: "120分",
    price: "¥8,970",
    description: "お時間をかけて頭から足先まで贅沢に癒やすコースです。日々の喧騒を離れ、深い休息を求める方へ。",
    image: "https://kusatsu-aroma.com/_emdash/api/media/file/01M6ATQMMW5G79XSPG2SEFAPYK.01M6ATQN9FSYNBG5EGSGM5GB8H.jpg",
    recommend: false,
  },
  {
    name: "ショート オイルトリートメント",
    duration: "60分",
    price: "¥4,290",
    description: "お忙しい合間にも心身の疲れをリセットしていただける、気軽なショートトリートメントです。",
    image: "https://kusatsu-aroma.com/_emdash/api/media/file/01M6ATQMN2QSQ1TVSNF5MJMGK8.01M6ATQNK91DGFAVQEVT75PP3M.jpg",
    recommend: false,
  }
];

// 出張トリートメント
const visitMenu = {
  name: "出張オイルトリートメントコース",
  duration: "90分〜",
  price: "¥9,000〜",
  priceNote: "（出張費込 / エリア等要確認）",
  description: "サロンへお越しいただくのが難しい日や、施術後にそのまま眠りにつきたい夜に。ご自宅や宿泊先へお伺いし、サロン同様の心地よいトリートメントをお届けいたします。",
  image: "https://kusatsu-aroma.com/_emdash/api/media/file/01M6AV6VC8MA2BW09N3G3ZJDJH.01M6AV6WE1CMQGVKKN2QYX2FVG.jpg",
  notes: "※出張サービスは移動時間の調整・確認が必要なため、Squareによるネット即時予約は受け付けておりません。公式LINEまたはお電話にて日程をご相談ください。"
};
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>メニュー・料金 | 女性専用サロン La Chouette（ラ・シュエット）</title>
    <meta name="description" content="滋賀県草津市の女性専用サロン La Chouette（ラ・シュエット）のメニュー・料金案内です。心地よいアロマオイルトリートメントで深い癒やしのひとときをお届けします。" />
    
    <!-- Astroのバンドル解析をスキップしブラウザで直接実行させるための is:inline -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              alabaster: '#F7F4EF',
              champagne: '#EDE7DF',
              sand: '#DCD3C6',
              bronze: '#8E735B',
              charcoal: '#221F1D',
              taupe: '#7D7571',
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-[#F7F4EF] text-[#221F1D] font-sans antialiased selection:bg-[#DCD3C6] selection:text-[#221F1D]">
    <Header />

    <main class="min-h-screen">
      <!-- ページヘッダー -->
      <section class="py-16 md:py-24 bg-[#EDE7DF] border-b border-[#DCD3C6]">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
          <span class="text-xs md:text-sm font-semibold tracking-widest text-[#8E735B] uppercase block mb-2">MENU & PRICE</span>
          <h1 class="text-2xl md:text-4xl font-serif text-[#221F1D] mb-4">メニュー・料金</h1>
          <p class="text-sm md:text-base text-[#7D7571] max-w-2xl mx-auto leading-relaxed">
            日常の忙しさから離れ、心地よいアロマの香りと温かなオイルトリートメントで、心と身体が深くほどけるひとときを。私がお一人おひとりに寄り添い、丁寧におもてなしいたします。
          </p>
        </div>
      </section>

      <!-- サロン施術メニュー -->
      <section class="py-16 md:py-20 px-4 sm:px-6 max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-semibold tracking-wider text-[#8E735B] uppercase block mb-1">SALON TREATMENT</span>
          <h2 class="text-xl md:text-3xl font-serif text-[#221F1D]">サロン施術メニュー</h2>
          <p class="text-xs md:text-sm text-[#7D7571] mt-2">完全プライベート空間で過ごす、深い癒やしのリラクゼーション</p>
        </div>

        <div class="grid gap-8 md:grid-cols-3">
          {salonMenus.map((item) => (
            <div class={`rounded-xl p-6 md:p-7 flex flex-col justify-between border transition-all duration-300 hover:shadow-lg relative ${item.recommend ? 'bg-[#EDE7DF] border-[#8E735B] shadow-md' : 'bg-[#EDE7DF] border-[#DCD3C6]'}`}>
              {item.recommend && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#8E735B] text-white text-xs px-3 py-1 rounded-full tracking-wide shadow-sm z-10 font-medium">
                  おすすめ
                </div>
              )}
              
              <div>
                <h3 class="text-lg font-bold text-[#221F1D] mb-1">{item.name}</h3>
                <div class="flex items-baseline gap-2 mb-4">
                  <span class="text-2xl font-bold text-[#8E735B]">{item.price}</span>
                  <span class="text-xs text-[#7D7571]">/ {item.duration}</span>
                </div>

                <!-- メニュー料金直下の画像 -->
                <div class="overflow-hidden rounded-lg aspect-[16/10] bg-[#DCD3C6] mb-4 shadow-inner">
                  <img
                    src={item.image}
                    alt={`${item.name}の施術イメージ`}
                    class="w-full h-full object-cover object-center transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                  />
                </div>

                <p class="text-xs md:text-sm text-[#7D7571] leading-relaxed mb-6">
                  {item.description}
                </p>
              </div>

              <div>
                <a
                  href="https://app.squareup.com/appointments/book/fqk7s06sbwkojt/L7STD9CD9RRTC/start"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${item.name}をSquareでWeb予約する`}
                  class="block w-full text-center bg-[#8E735B] hover:bg-[#78614C] text-white text-sm font-medium py-3 px-4 rounded-lg transition-colors duration-200"
                >
                  このコースをWeb予約
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- メニュー料金下のデザインセクション（その他画像2枚を活用したビジュアル紹介） -->
      <section class="py-16 md:py-20 bg-[#EDE7DF] border-t border-[#DCD3C6] px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-12">
            <span class="text-xs font-semibold tracking-wider text-[#8E735B] uppercase block mb-1">TREATMENT EXPERIENCE</span>
            <h2 class="text-xl md:text-3xl font-serif text-[#221F1D]">温もりと静寂に包まれるひととき</h2>
            <p class="text-xs md:text-sm text-[#7D7571] mt-2">
              慌ただしい日常のスイッチをオフにして、心と身体が深く息を吹き返す時間を
            </p>
          </div>

          <div class="grid gap-8 md:grid-cols-2">
            <!-- カード1: オイルトリートメントの心地よさ -->
            <div class="bg-[#F7F4EF] rounded-2xl overflow-hidden border border-[#DCD3C6] shadow-sm flex flex-col group">
              <div class="aspect-[16/10] overflow-hidden bg-[#DCD3C6]">
                <img
                  src="https://kusatsu-aroma.com/_emdash/api/media/file/01M6AV6VAZEMN4TK3Y2KSF8W03.01M6AV6WC8476QG42D7M4G2BRZ.jpg"
                  alt="厳選したアロマオイルで行うトリートメント"
                  class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="p-6 md:p-8 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-[11px] font-semibold tracking-widest text-[#8E735B] uppercase block mb-1">AROMA & OIL</span>
                  <h3 class="text-base md:text-lg font-bold text-[#221F1D] mb-2">
                    お肌になじむ温かなオイルと優しい香り
                  </h3>
                  <p class="text-xs md:text-sm text-[#7D7571] leading-relaxed">
                    厳選した天然由来の上質なオイルを贅沢に使用。お好みの心地よい香りに包まれながら、手のひらから伝わる適度な圧と温もりで、こわばった緊張をなめらかに解き放ちます。
                  </p>
                </div>
              </div>
            </div>

            <!-- カード2: オールハンドの贅沢なケア -->
            <div class="bg-[#F7F4EF] rounded-2xl overflow-hidden border border-[#DCD3C6] shadow-sm flex flex-col group">
              <div class="aspect-[16/10] overflow-hidden bg-[#DCD3C6]">
                <img
                  src="https://kusatsu-aroma.com/_emdash/api/media/file/01M6AV6V67J0ZDRVM57H3XM9VC.01M6AV6W9Y8TXA8BECK1FVXTTT.jpg"
                  alt="オールハンドで行う丁寧なオイルトリートメント"
                  class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="p-6 md:p-8 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-[11px] font-semibold tracking-widest text-[#8E735B] uppercase block mb-1">ALL HAND CARE</span>
                  <h3 class="text-base md:text-lg font-bold text-[#221F1D] mb-2">
                    全身を包み込むオールハンドの丁寧な手技
                  </h3>
                  <p class="text-xs md:text-sm text-[#7D7571] leading-relaxed">
                    機械に頼らず、私自身のオールハンドで指先・足先まで巡りを意識しながら施術いたします。呼吸に合わせたゆったりとしたストロークで、深いリラクゼーションへと導きます。
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 出張トリートメントメニュー（その他画像1枚を組み込んだ洗練された2カラムデザイン） -->
      <section class="py-16 md:py-24 bg-[#F7F4EF] border-t border-[#DCD3C6] px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-12">
            <span class="text-xs font-semibold tracking-wider text-[#8E735B] uppercase block mb-1">VISIT TREATMENT</span>
            <h2 class="text-xl md:text-3xl font-serif text-[#221F1D]">出張トリートメント</h2>
            <p class="text-xs md:text-sm text-[#7D7571] mt-2">ご自宅やご滞在先で、移動の負担なく味わうリラクゼーション</p>
          </div>

          <div class="bg-[#EDE7DF] rounded-2xl border border-[#DCD3C6] overflow-hidden shadow-sm grid md:grid-cols-12 gap-0">
            <!-- 左カラム：出張トリートメントのイメージ画像 -->
            <div class="md:col-span-5 relative min-h-[260px] md:min-h-full bg-[#DCD3C6] overflow-hidden group">
              <img
                src={visitMenu.image}
                alt="出張トリートメントのイメージ"
                class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#221F1D]/40 via-transparent to-transparent md:hidden"></div>
              <div class="absolute bottom-3 left-4 md:hidden text-white text-xs font-medium tracking-wide">
                プライベート空間へ直接お届け
              </div>
            </div>

            <!-- 右カラム：コース詳細＆ご相談導線 -->
            <div class="md:col-span-7 p-6 sm:p-8 md:p-10 flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
                  <h3 class="text-xl font-bold text-[#221F1D]">{visitMenu.name}</h3>
                  <div class="text-right">
                    <span class="text-2xl font-bold text-[#8E735B]">{visitMenu.price}</span>
                    <span class="text-xs text-[#7D7571] block sm:inline sm:ml-1">{visitMenu.priceNote}</span>
                  </div>
                </div>

                <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#F7F4EF] rounded-full text-xs text-[#7D7571] border border-[#DCD3C6] mb-4">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#8E735B]"></span>
                  所要目安: {visitMenu.duration}
                </div>

                <p class="text-xs md:text-sm text-[#7D7571] leading-relaxed mb-6">
                  {visitMenu.description}
                </p>

                <div class="bg-[#F7F4EF] rounded-xl p-4 mb-6 border border-[#DCD3C6]">
                  <p class="text-xs text-[#7D7571] leading-relaxed">
                    {visitMenu.notes}
                  </p>
                </div>
              </div>

              <!-- ご予約・ご相談アクションボタン -->
              <div class="flex flex-col sm:flex-row gap-3 pt-2">
                <a
                  href="https://lin.ee/Sv8oVDh"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="出張トリートメントについて公式LINEで日程を相談する"
                  class="flex-1 inline-flex items-center justify-center bg-[#8E735B] hover:bg-[#78614C] text-white text-sm font-medium py-3.5 px-6 rounded-lg transition-colors duration-200 shadow-sm"
                >
                  公式LINEで日程を相談する
                </a>
                <a
                  href="tel:080-6219-3290"
                  aria-label="出張トリートメントについて電話で問い合わせる"
                  class="inline-flex items-center justify-center border border-[#8E735B] text-[#8E735B] hover:bg-[#8E735B] hover:text-white text-sm font-medium py-3.5 px-6 rounded-lg transition-colors duration-200"
                >
                  電話で問い合わせる
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 施術に関するご案内 -->
      <section class="py-16 md:py-20 px-4 sm:px-6 max-w-4xl mx-auto border-t border-[#DCD3C6]">
        <div class="text-center mb-10">
          <span class="text-xs font-semibold tracking-wider text-[#8E735B] uppercase block mb-1">GUIDE</span>
          <h2 class="text-xl md:text-3xl font-serif text-[#221F1D]">ご利用に関するご案内</h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="bg-[#EDE7DF] rounded-xl p-6 border border-[#DCD3C6]">
            <h3 class="text-base font-bold text-[#221F1D] mb-3 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#8E735B]"></span>
              女性専用の安心できるプライベート空間
            </h3>
            <p class="text-xs md:text-sm text-[#7D7571] leading-relaxed">
              当サロンは女性専用のリラクゼーションサロンです。日常から離れ、心置きなくリラックスしていただける落ち着いた環境を整えております。
            </p>
          </div>

          <div class="bg-[#EDE7DF] rounded-xl p-6 border border-[#DCD3C6]">
            <h3 class="text-base font-bold text-[#221F1D] mb-3 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#8E735B]"></span>
              お支払い方法・お問い合わせ
            </h3>
            <p class="text-xs md:text-sm text-[#7D7571] leading-relaxed">
              各種カード決済、QRコード決済に対応しております。ご不明点やご相談がございましたら、お気軽に公式LINEまたはお電話（080-6219-3290）にてお尋ねください。
            </p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
