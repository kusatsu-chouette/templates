---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'ページが見つかりませんでした (404) ｜ 草津の女性専用サロン La Chouette';
const pageDescription = 'お探しのページは移動または削除された可能性がございます。草津市の女性専用リラクゼーションサロン La Chouette（ラ・シュエット）のトップページ、主要案内、またはブログ記事検索よりお進みください。';
---

<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600&family=Noto+Serif+JP:wght@300;400;600&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN / Custom Config (is:inline 必須) -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            alabaster: '#F7F4EF',
            champagne: '#EDE7DF',
            sand: '#DCD3C6',
            bronze: '#8E735B',
            charcoal: '#221F1D',
            taupe: '#7D7571',
          },
          fontFamily: {
            serif: ['"Noto Serif JP"', 'serif'],
            cormorant: ['"Cormorant Garamond"', 'serif'],
          }
        }
      }
    }
  </script>
</head>
<body class="bg-alabaster text-charcoal font-serif antialiased min-h-screen flex flex-col selection:bg-sand selection:text-charcoal">
  <Header />

  <main class="flex-grow flex items-center justify-center pt-28 pb-20 px-4 sm:px-6">
    <div class="max-w-2xl w-full text-center">
      <!-- 404 装飾表示 -->
      <span class="font-cormorant text-7xl sm:text-8xl text-bronze/60 font-light tracking-widest block mb-1 select-none">
        404
      </span>
      <span class="inline-block font-cormorant text-taupe tracking-widest text-xs uppercase mb-6">
        Page Not Found
      </span>

      <h1 class="text-2xl sm:text-3xl font-normal text-charcoal tracking-wide mb-4">
        ページが見つかりませんでした
      </h1>
      
      <div class="w-12 h-px bg-sand mx-auto mb-6"></div>

      <p class="text-taupe text-sm sm:text-base leading-relaxed max-w-md mx-auto mb-8">
        お探しのページは移動または削除されたか、URLが正しくない可能性がございます。<br class="hidden sm:inline" />
        記事検索、または下記の主要案内よりお進みください。
      </p>

      <!-- 記事内キーワード検索フォーム -->
      <form
        method="get"
        action="/search"
        role="search"
        aria-label="記事を検索"
        class="relative max-w-md mx-auto mb-10"
      >
        <label for="not-found-query" class="sr-only">記事キーワード検索</label>
        <div class="relative flex items-center">
          <svg
            class="absolute left-4 w-4 h-4 text-taupe pointer-events-none"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            id="not-found-query"
            class="w-full h-12 pl-11 pr-12 text-sm bg-champagne/50 border border-sand rounded-full text-charcoal placeholder-taupe/70 focus:outline-none focus:border-bronze focus:ring-1 focus:ring-bronze transition-all"
            type="search"
            name="q"
            placeholder="ブログ記事を検索する"
          />
          <button
            type="submit"
            class="absolute right-1.5 w-9 h-9 flex items-center justify-center rounded-full bg-bronze text-alabaster hover:bg-[#78614C] transition-colors"
            aria-label="検索を実行"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </form>

      <!-- 主要ページへの案内カード -->
      <div class="bg-champagne/40 border border-sand rounded-2xl p-6 sm:p-8 mb-10 text-left max-w-xl mx-auto shadow-sm">
        <h2 class="text-xs font-semibold text-charcoal tracking-widest uppercase mb-4 text-center">
          サロンの主要なご案内
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a
            href="/"
            class="flex items-center justify-between p-3.5 rounded-lg bg-alabaster border border-sand/60 hover:border-bronze hover:shadow-sm transition-all group"
          >
            <span class="text-xs text-charcoal group-hover:text-bronze transition-colors">トップページ</span>
            <span class="text-taupe text-xs group-hover:text-bronze group-hover:translate-x-0.5 transition-all">→</span>
          </a>
          <a
            href="/posts"
            class="flex items-center justify-between p-3.5 rounded-lg bg-alabaster border border-sand/60 hover:border-bronze hover:shadow-sm transition-all group"
          >
            <span class="text-xs text-charcoal group-hover:text-bronze transition-colors">ブログ一覧</span>
            <span class="text-taupe text-xs group-hover:text-bronze group-hover:translate-x-0.5 transition-all">→</span>
          </a>
          <a
            href="/menu"
            class="flex items-center justify-between p-3.5 rounded-lg bg-alabaster border border-sand/60 hover:border-bronze hover:shadow-sm transition-all group"
          >
            <span class="text-xs text-charcoal group-hover:text-bronze transition-colors">メニュー・料金</span>
            <span class="text-taupe text-xs group-hover:text-bronze group-hover:translate-x-0.5 transition-all">→</span>
          </a>
          <a
            href="/therapist"
            class="flex items-center justify-between p-3.5 rounded-lg bg-alabaster border border-sand/60 hover:border-bronze hover:shadow-sm transition-all group"
          >
            <span class="text-xs text-charcoal group-hover:text-bronze transition-colors">セラピスト紹介</span>
            <span class="text-taupe text-xs group-hover:text-bronze group-hover:translate-x-0.5 transition-all">→</span>
          </a>
        </div>
      </div>

      <!-- アクションボタン -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-bronze text-alabaster text-xs tracking-widest uppercase hover:bg-[#78614C] transition-all shadow-sm"
        >
          トップページへ戻る
        </a>
        <a
          href="https://lin.ee/nzuEONf"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-3.5 rounded-full bg-champagne text-charcoal border border-sand text-xs tracking-wider hover:border-bronze transition-colors inline-flex items-center justify-center gap-2"
        >
          <span>公式LINEで問い合わせる</span>
          <span class="text-taupe text-xs">↗</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</body>
</html>
