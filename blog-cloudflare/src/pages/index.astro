---
import {
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// 1. 管理画面の「Pages」からスラッグ「home」のデータを取得
const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// 2. SEO情報・サイトタイトルの生成
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: "",
});
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    
    {/* 余計な余白や枠組みを排除するベース設定 */}
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
      }
    </style>
  </head>
  <body>
    <main>
      {/* 管理画面の「ホーム」に入力したHTML/CSS/JSをそのまま全画面出力 */}
      <PortableText value={page.data.content} />
    </main>
  </body>
</html>
