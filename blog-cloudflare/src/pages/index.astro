---
// src/pages/index.astro
import { getEmDashCollection } from '@emdash/core';

// 管理画面のPagesからスラッグ「home」を取得
const pages = await getEmDashCollection('pages', {
  where: { slug: 'home' },
  limit: 1,
});

const page = pages[0];

const pageTitle = page?.data?.seo?.title || page?.data?.title || 'ラ・シュエット';
const pageDescription = page?.data?.seo?.description || '';
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
      }
    </style>
  </head>
  <body>
    {page ? (
      <Fragment set:html={page.body} />
    ) : (
      <div style="padding: 40px; text-align: center; font-family: sans-serif;">
        <p>管理画面の「Pages」でスラッグ「home」の固定ページを公開してください。</p>
      </div>
    )}
  </body>
</html>
