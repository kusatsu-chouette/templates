---
import {
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// 1. 各セクション部品の読み込み
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Concept from "../components/Concept.astro";
import Therapist from "../components/Therapist.astro";
import Reviews from "../components/Reviews.astro";
import Menu from "../components/Menu.astro";
import Simulator from "../components/Simulator.astro";
import Faq from "../components/Faq.astro";
import Access from "../components/Access.astro";
import Footer from "../components/Footer.astro";
import Modals from "../components/Modals.astro";

// 2. 管理画面の「Pages」からホームデータ取得
const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// 3. SEO設定
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: "",
});
---

<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>La Chouette（ラ・シュエット） | 女性専用・ベテラン男性セラピストによるアロマオイルトリートメントサロン（滋賀県草津市）</title>
  <meta name="description" content="滋賀県草津市大路の女性専用プライベートサロン「La Chouette（ラ・シュエット）」。施術歴15年の男性セラピストによる密着感のあるロングストロークのアロマオイルマッサージで非日常の癒やしを。当サイトからのご予約でご新規様10分無料延長。">

  <!-- Tailwind CSS & 設定 -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            alabaster: '#F7F4EF',
            champagne: '#EDE7DF',
            sand: '#DCD3C6',
            bronze: '#8E735B',
            bronzeDark: '#6C5540',
            charcoal: '#221F1D',
            taupe: '#686058',
            rosewood: '#9A7B73',
            sage: '#46524A',
            sageLight: '#E8ECE9',
            lineGreen: '#06C755'
          },
          fontFamily: {
            serifEn: ['"Cormorant Garamond"', 'serif'],
            serifJp: ['"Shippori Mincho"', 'serif'],
            sansEn: ['"Plus Jakarta Sans"', 'sans-serif'],
            sansJp: ['"Noto Sans JP"', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Noto+Sans+JP:wght@300;400;500&family=Plus+Jakarta+Sans:wght@300;400;500&family=Shippori+Mincho:wght@400;500;600&display=swap" rel="stylesheet">

  <style is:global>
    body {
      background-color: #F7F4EF;
      color: #221F1D;
      font-family: 'Noto Sans JP', sans-serif;
      font-weight: 300;
      letter-spacing: 0.05em;
      -webkit-font-smoothing: antialiased;
    }
    .em-dash {
      display: inline-block;
      width: 2rem;
      height: 1px;
      background-color: currentColor;
      vertical-align: middle;
      margin: 0 0.6rem;
    }
    .bg-silk {
      background-image: radial-gradient(rgba(142, 115, 91, 0.05) 1px, transparent 0);
      background-size: 20px 20px;
    }
    .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }
    .portal-modal-overlay {
      display: none;
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      background-color: rgba(34, 31, 29, 0.85) !important;
      backdrop-filter: blur(4px) !important;
      -webkit-backdrop-filter: blur(4px) !important;
      z-index: 99999999 !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 16px !important;
      box-sizing: border-box !important;
    }
    .portal-modal-overlay.is-active {
      display: flex !important;
    }
    .portal-modal-card {
      margin: auto !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
  </style>
</head>
<body class="bg-alabaster text-charcoal bg-silk selection:bg-bronze selection:text-white">

  <!-- 1. ブランドヘッダー -->
  <Header />

  <main>
    <!-- 2. ファーストビュー＆深夜営業案内 -->
    <Hero />

    <!-- 3. サロンの想い・3つの理由 -->
    <Concept />

    <!-- 4. セラピスト紹介（頭上切れ解消済み） -->
    <Therapist />

    <!-- 5. お客様の声（原本拡大機能） -->
    <Reviews />

    <!-- 6. 施術メニュー・料金案内 -->
    <Menu />

    <!-- 7. おすすめコース診断 -->
    <Simulator />

    <!-- 8. よくある質問・安心のお約束 -->
    <Faq />

    <!-- 9. サロン所在地・アクセス -->
    <Access />

    <!-- 10. 管理画面（EmDash）で記事や自由入力ブロックがある場合の出力 -->
    {page?.data?.content && page.data.content.length > 0 && (
      <section class="py-12 px-4 max-w-xl lg:max-w-3xl mx-auto border-t border-sand/70">
        <PortableText value={page.data.content} />
      </section>
    )}
  </main>

  <!-- 11. フッター -->
  <Footer />

  <!-- 12. 予約Hubモーダル・口コミ拡大モーダル・スクリプト -->
  <Modals />

</body>
</html>
