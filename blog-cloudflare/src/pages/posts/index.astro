---
import {
  getEmDashCollection,
  getTermsForEntries,
} from "emdash";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;

// 記事データの取得
const {
  entries: posts,
  cacheHint,
  nextCursor,
} = await getEmDashCollection("posts", {
  orderBy: { published_at: "desc" },
  limit: 12,
  cursor,
});

if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}

// タグデータの取得
const tagsByEntry = await getTermsForEntries(
  "posts",
  posts.map((p) => p.data.id),
  "tag",
);

const formattedPosts = posts.map((post) => ({
  post,
  tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
    slug: t.slug,
    label: t.label,
  })),
}));

// 1ページ目の先頭記事を「特集記事（FEATURED）」として強調表示
const isFirstPage = !cursor;
const featuredPost = isFirstPage && formattedPosts.length > 0 ? formattedPosts[0] : null;
const regularPosts = featuredPost ? formattedPosts.slice(1) : formattedPosts;

// 全6カテゴリーのタブ定義（お知らせを「すべて」の直後に配置）
const categoryTabs = [
  { name: "すべて", href: "/posts", active: true },
  { name: "お知らせ", href: "/category/news", active: false },
  { name: "サロン・施術", href: "/category/salon-treatment", active: false },
  { name: "心と体のケア", href: "/category/body-mind-care", active: false },
  { name: "男性セラピスト", href: "/category/male-therapist", active: false },
  { name: "お客様の声", href: "/category/customer-reviews", active: false },
  { name: "日常・メンタル", href: "/category/daily-mental", active: false },
];

const pageTitle = "サロンコラム・お知らせ一覧 ｜ 草津の女性専用サロン La Chouette";
const pageDescription = "滋賀県草津市の女性専用リラクゼーションサロン La Chouette（ラ・シュエット）の公式コラム。サロンからのお知らせ、オイルトリートメントのこだわり、男性セラピストならではの安心感、心とお体を深く緩める日々のヒントをお届けします。";
---

<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600&family=Noto+Serif+JP:wght@300;400;600&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN / Custom Config (is:inline 必須) -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            alabaster: '#F7F4EF',
            champagne: '#EDE7DF',
            sand: '#DCD3C6',
            bronze: '#8E735B',
            charcoal: '#221F1D',
            taupe: '#7D7571',
          },
          fontFamily: {
            serif: ['"Noto Serif JP"', 'serif'],
            cormorant: ['"Cormorant Garamond"', 'serif'],
          }
        }
      }
    }
  </script>
</head>
<body class="bg-alabaster text-charcoal font-serif antialiased min-h-screen flex flex-col selection:bg-sand selection:text-charcoal">
  <Header />

  <main class="flex-grow pt-24 pb-20">
    <!-- パンくずリスト -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-8">
      <nav class="flex items-center text-xs text-taupe space-x-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-bronze transition-colors">ホーム</a>
        <span>/</span>
        <span class="text-charcoal font-medium">ブログ・コラム</span>
      </nav>
    </div>

    <!-- ページタイトルヘッダー -->
    <header class="max-w-4xl mx-auto px-4 sm:px-6 text-center mb-12 sm:mb-16">
      <span class="inline-block font-cormorant text-bronze tracking-widest text-sm uppercase mb-3">
        Journal & Columns
      </span>
      <h1 class="text-3xl sm:text-4xl font-normal text-charcoal tracking-wide mb-4">
        コラム ＆ お知らせ
      </h1>
      <div class="w-12 h-px bg-sand mx-auto mb-6"></div>
      <p class="text-taupe text-sm sm:text-base leading-relaxed max-w-xl mx-auto">
        日々の役割を脱ぎ捨てて、ひとりの女性へと還る時間。<br class="hidden sm:inline" />
        施術への想いやサロンからのお便り、心とお体をやさしく解きほぐすヒントを綴っています。
      </p>
    </header>

    <!-- カテゴリー切り替えタブ（スマホ対応・横スクロール） -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-14">
      <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-3 pt-1 scrollbar-none sm:flex-wrap">
        {categoryTabs.map((tab) => (
          <a
            href={tab.href}
            class={`whitespace-nowrap px-4 py-2 rounded-full text-xs tracking-wider transition-all duration-200 border ${
              tab.active
                ? "bg-bronze text-alabaster border-bronze shadow-sm pointer-events-none font-medium"
                : "bg-champagne/60 text-charcoal border-sand/80 hover:border-bronze hover:bg-champagne"
            }`}
          >
            {tab.name}
          </a>
        ))}
      </div>
    </div>

    <!-- 記事一覧コンテナ -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      {formattedPosts.length > 0 ? (
        <>
          <!-- 特集記事（1ページ目先頭） -->
          {featuredPost && (
            <section class="mb-14">
              <div class="relative bg-champagne/40 border border-sand rounded-2xl overflow-hidden p-6 sm:p-8 transition-shadow hover:shadow-md">
                <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 items-center">
                  {featuredPost.post.data.featured_image && (
                    <div class="w-full lg:w-1/2 aspect-[16/10] overflow-hidden rounded-xl bg-sand/30 flex-shrink-0">
                      <img
                        src={featuredPost.post.data.featured_image}
                        alt={featuredPost.post.data.title}
                        class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  )}
                  <div class="w-full lg:w-1/2 flex flex-col justify-center">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="inline-block px-3 py-1 rounded-full bg-bronze/10 text-bronze text-[11px] tracking-widest uppercase font-cormorant font-semibold">
                        FEATURED
                      </span>
                      {featuredPost.post.data.publishedAt && (
                        <time class="text-xs text-taupe font-cormorant">
                          {new Date(featuredPost.post.data.publishedAt).toLocaleDateString("ja-JP", {
                            year: "numeric",
                            month: "2-digit",
                            day: "2-digit",
                          }).replace(/\//g, ".")}
                        </time>
                      )}
                    </div>
                    <h2 class="text-xl sm:text-2xl font-normal text-charcoal mb-4 leading-snug">
                      <a
                        href={`/posts/${featuredPost.post.slug}`}
                        class="hover:text-bronze transition-colors"
                      >
                        {featuredPost.post.data.title}
                      </a>
                    </h2>
                    {featuredPost.post.data.excerpt && (
                      <p class="text-taupe text-sm leading-relaxed mb-6 line-clamp-3">
                        {featuredPost.post.data.excerpt}
                      </p>
                    )}
                    <div>
                      <a
                        href={`/posts/${featuredPost.post.slug}`}
                        class="inline-flex items-center text-xs tracking-widest text-bronze font-medium hover:text-[#78614C] transition-colors group"
                      >
                        記事を読む
                        <span class="ml-2 transform group-hover:translate-x-1 transition-transform">→</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          )}

          <!-- 通常記事グリッド一覧 -->
          {regularPosts.length > 0 && (
            <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
              {regularPosts.map(({ post, tags }) => (
                <PostCard post={post} tags={tags} />
              ))}
            </section>
          )}

          <!-- ページネーション -->
          <div class="mt-12 flex justify-center">
            <Pagination
              basePath="/posts"
              cursor={cursor}
              nextCursor={nextCursor}
            />
          </div>
        </>
      ) : (
        <div class="bg-champagne/40 border border-sand rounded-2xl p-12 text-center max-w-lg mx-auto shadow-sm">
          <h2 class="text-base font-medium text-charcoal mb-3">
            {cursor ? "これ以上の記事はありません" : "記事を準備しております"}
          </h2>
          <p class="text-taupe text-sm leading-relaxed mb-8">
            サロンからのお知らせや、心身を癒やすコラムを順次お届けしてまいります。
          </p>
          <a
            href="/"
            class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-bronze text-alabaster text-xs tracking-wider hover:bg-[#78614C] transition-colors shadow-sm"
          >
            サロンTOPへ戻る
          </a>
        </div>
      )}
    </div>
  </main>

  <Footer />
</body>
</html>
