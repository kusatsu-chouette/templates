---
import {
  getEmDashEntry,
  getTermsForEntries,
  getSeoMeta,
  decodeSlug,
  getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
  return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
  return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// アイキャッチ画像のURL取得
function getImageUrl(img: unknown): string | undefined {
  if (!img || typeof img !== "object") return undefined;
  const image = img as Record<string, unknown>;
  if (typeof image.src === "string" && image.src) {
    return image.src.startsWith("http")
      ? image.src
      : `${Astro.url.origin}${image.src}`;
  }
  const meta = image.meta as Record<string, unknown> | undefined;
  const storageKey =
    (typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
    (typeof image.id === "string" ? image.id : undefined);
  if (storageKey) {
    return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
  }
  return undefined;
}

const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// SEOメタ情報の生成
const seo = getSeoMeta(post, {
  siteTitle: siteTitle || "女性専用サロン La Chouette（ラ・シュエット）",
  siteUrl: Astro.url.origin,
  path: Astro.url.pathname.replace(/\/$/, ""),
  defaultOgImage: featuredImageUrl,
});

const tags = post.data.terms?.tag ?? [];
const readingTime = getReadingTime(post.data.content);
const publishedAt = post.data.publishedAt ?? null;
const publishDate = publishedAt ? formatDate(publishedAt, "long") : null;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seo.title || `${post.data.title} | 女性専用サロン La Chouette`}</title>
  <meta name="description" content={seo.description || `${post.data.title} - 滋賀県草津市の女性専用完全個室サロン「ラ・シュエット」のブログです。`} />

  <!-- Tailwind CSS v3 CDN（is:inline 必須） -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            alabaster: '#F7F4EF',
            champagne: '#EDE7DF',
            sand: '#DCD3C6',
            bronze: '#8E735B',
            charcoal: '#221F1D',
            taupe: '#7D7571',
          }
        }
      }
    }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <style is:global>
    body {
      font-family: 'Zen Kaku Gothic New', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #F7F4EF;
      color: #221F1D;
    }
    .font-mincho {
      font-family: 'Shippori Mincho', serif;
    }

    /* ========================================================
       La Chouette 大人女性向けブログ装飾ボックス
       ======================================================== */

    /* 1. 付箋風ボックス（左ブロンズ太線・シャンパン背景） */
    .box-fusen {
      background-color: #EDE7DF;
      border-left: 5px solid #8E735B;
      padding: 1.25rem 1.5rem;
      margin: 2rem 0;
      border-radius: 0 0.5rem 0.5rem 0;
      color: #221F1D;
      line-height: 1.85;
    }

    /* 2. 左縦線ボックス（すっきりした引用・補足） */
    .box-line {
      background-color: #FAF8F5;
      border-left: 2px solid #8E735B;
      padding: 1rem 1.25rem;
      margin: 1.75rem 0;
      color: #221F1D;
      line-height: 1.8;
    }

    /* 3. ポイントボックス（上部POINTバッジ＋ブロンズ枠線） */
    .box-point {
      position: relative;
      background-color: #FFFFFF;
      border: 1px solid #8E735B;
      border-radius: 0.5rem;
      padding: 1.75rem 1.5rem 1.25rem;
      margin: 2.25rem 0 1.75rem;
    }
    .box-point::before {
      content: 'POINT';
      position: absolute;
      top: -0.75rem;
      left: 1.25rem;
      background-color: #8E735B;
      color: #FFFFFF;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      padding: 0.15rem 0.85rem;
      border-radius: 9999px;
    }

    /* 4. チェックボックス（上部CHECKバッジ＋サンド枠線） */
    .box-check {
      position: relative;
      background-color: #FFFFFF;
      border: 1px solid #DCD3C6;
      border-radius: 0.5rem;
      padding: 1.75rem 1.5rem 1.25rem;
      margin: 2.25rem 0 1.75rem;
    }
    .box-check::before {
      content: 'CHECK';
      position: absolute;
      top: -0.75rem;
      left: 1.25rem;
      background-color: #7D7571;
      color: #FFFFFF;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      padding: 0.15rem 0.85rem;
      border-radius: 9999px;
    }

    /* 5. 窪み（インセット）ボックス（柔らかな陰影とカード質感） */
    .box-inset {
      background-color: #EDE7DF;
      box-shadow: inset 0 2px 4px rgba(34, 31, 29, 0.05);
      border-radius: 0.75rem;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      color: #221F1D;
      line-height: 1.85;
    }

    /* 6. かぎ括弧ボックス（上品な四隅アクセント） */
    .box-bracket {
      position: relative;
      background-color: #FFFFFF;
      padding: 1.75rem 2rem;
      margin: 2.25rem 0;
      border-radius: 0.25rem;
    }
    .box-bracket::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 24px;
      height: 24px;
      border-top: 2px solid #8E735B;
      border-left: 2px solid #8E735B;
    }
    .box-bracket::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: 0;
      width: 24px;
      height: 24px;
      border-bottom: 2px solid #8E735B;
      border-right: 2px solid #8E735B;
    }

    /* 7. 上品な二重線ボックス */
    .box-double {
      background-color: #FFFFFF;
      border: 3px double #8E735B;
      border-radius: 0.375rem;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      line-height: 1.85;
    }

    /* 8. スティッチ風ボックス（点線枠） */
    .box-stitch {
      background-color: #FAF8F5;
      border: 1.5px dashed #DCD3C6;
      border-radius: 0.5rem;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      line-height: 1.85;
    }

    /* ========================================================
       Markdown記事本文（自動適用タイポグラフィ）
       ======================================================== */
    .entry-content h2 {
      font-family: 'Shippori Mincho', serif;
      font-size: 1.35rem;
      font-weight: 600;
      color: #221F1D;
      border-left: 4px solid #8E735B;
      padding: 0.35rem 0 0.35rem 0.85rem;
      margin-top: 3rem;
      margin-bottom: 1.5rem;
      line-height: 1.45;
    }
    @media (min-width: 768px) {
      .entry-content h2 {
        font-size: 1.5rem;
      }
    }
    .entry-content h3 {
      font-family: 'Shippori Mincho', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: #221F1D;
      border-bottom: 1px solid #DCD3C6;
      padding-bottom: 0.5rem;
      margin-top: 2.25rem;
      margin-bottom: 1.25rem;
      line-height: 1.4;
    }
    .entry-content p {
      color: #221F1D;
      font-size: 0.975rem;
      line-height: 2;
      margin-bottom: 1.6rem;
      letter-spacing: 0.02em;
    }
    .entry-content ul {
      list-style-type: disc;
      padding-left: 1.5rem;
      margin-bottom: 1.75rem;
      color: #221F1D;
      line-height: 1.9;
    }
    .entry-content ol {
      list-style-type: decimal;
      padding-left: 1.5rem;
      margin-bottom: 1.75rem;
      color: #221F1D;
      line-height: 1.9;
    }
    .entry-content li {
      margin-bottom: 0.5rem;
    }
    .entry-content blockquote {
      background-color: #EDE7DF;
      border-left: 3px solid #8E735B;
      padding: 1.25rem 1.5rem;
      margin: 2rem 0;
      color: #7D7571;
      border-radius: 0 0.375rem 0.375rem 0;
      line-height: 1.85;
    }
    .entry-content strong {
      font-weight: 600;
      background: linear-gradient(transparent 70%, #EDE7DF 70%);
      padding: 0 0.15rem;
    }
    .entry-content img {
      border-radius: 0.75rem;
      margin: 2rem auto;
      box-shadow: 0 4px 12px rgba(34, 31, 29, 0.05);
    }
  </style>
</head>

<body class="min-h-screen flex flex-col antialiased">
  <Header />

  <main class="flex-grow pt-24 pb-20">
    <article class="max-w-3xl mx-auto px-5 sm:px-8">
      <!-- 記事ヘッダー -->
      <header class="mb-10 text-center border-b border-sand pb-8">
        <div class="inline-flex flex-wrap items-center justify-center gap-2 mb-4">
          {tags.map((t) => (
            <span class="text-xs tracking-wider px-3 py-1 bg-champagne text-bronze rounded-full font-medium">
              {t.label}
            </span>
          ))}
          {publishDate && (
            <time class="text-xs text-taupe tracking-wider">{publishDate}</time>
          )}
          {readingTime && (
            <span class="text-xs text-taupe tracking-wider">読了目安 {readingTime}分</span>
          )}
        </div>
        <h1 class="text-2xl sm:text-3xl font-mincho text-charcoal font-medium leading-relaxed sm:leading-relaxed">
          {post.data.title}
        </h1>
        {post.data.excerpt && (
          <p class="text-sm text-taupe mt-4 leading-relaxed max-w-xl mx-auto">
            {post.data.excerpt}
          </p>
        )}
      </header>

      <!-- アイキャッチ画像 -->
      {post.data.featured_image && (
        <div class="mb-12 overflow-hidden rounded-2xl shadow-sm">
          <Image
            image={post.data.featured_image}
            sizes="(min-width: 1024px) 768px, 92vw"
            class="w-full h-auto object-cover max-h-[420px]"
            priority
          />
        </div>
      )}

      <!-- 記事本文（EmDash PortableText レンダリング） -->
      <div class="entry-content">
        <PortableText value={post.data.content} />
      </div>

      <!-- 記事末尾 - ご案内＆予約導線（CTAコンポーネント） -->
      <section class="mt-16 pt-10 border-t border-sand">
        <div class="bg-champagne/60 rounded-2xl p-6 sm:p-8 border border-sand text-center">
          <p class="text-xs tracking-widest text-bronze uppercase font-medium mb-1">Reservation & Contact</p>
          <h2 class="text-xl font-mincho text-charcoal font-medium mb-3">心と身体をゆるめる、静かな癒やしの時間</h2>
          <p class="text-sm text-taupe leading-relaxed max-w-lg mx-auto mb-6">
            草津市の完全個室サロン「ラ・シュエット」では、温かいホホバオイルを用いたオールハンドのトリートメントで、日々の緊張をほどくお手伝いをしております。
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <!-- Squareネット予約 -->
            <a
              href="https://app.squareup.com/appointments/book/fqk7s06sbwkojt/L7STD9CD9RRTC/start"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 bg-bronze text-white text-sm tracking-wider rounded-full hover:bg-[#78614C] transition duration-300 shadow-sm"
            >
              サロン施術の空き状況・ネット予約
            </a>

            <!-- 公式LINE相談 -->
            <a
              href="https://lin.ee/nzuEONf"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 bg-white border border-sand text-charcoal text-sm tracking-wider rounded-full hover:bg-alabaster transition duration-300"
            >
              公式LINEでお問い合わせ
            </a>
          </div>

          <p class="text-xs text-taupe mt-4">
            お電話でのご相談 - <a href="tel:080-6219-3290" class="hover:underline">080-6219-3290</a> / 完全予約制・女性専用
          </p>
        </div>
      </section>

      <!-- 記事一覧へ戻るリンク -->
      <div class="mt-12 text-center">
        <a href="/posts" class="inline-flex items-center text-sm text-taupe hover:text-bronze transition">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          記事一覧へ戻る
        </a>
      </div>
    </article>
  </main>

  <Footer />
</body>
</html>
