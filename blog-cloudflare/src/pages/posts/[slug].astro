---
// templates/blog-cloudflare/src/pages/posts/[slug].astro
import {
  getEmDashEntry,
  getSeoMeta,
  decodeSlug,
  getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CounselingCta from "../../components/CounselingCta.astro";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
  return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
  return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// アイキャッチ画像のURL取得
function getImageUrl(img: unknown): string | undefined {
  if (!img || typeof img !== "object") return undefined;
  const image = img as Record<string, unknown>;
  if (typeof image.src === "string" && image.src) {
    return image.src.startsWith("http")
      ? image.src
      : `${Astro.url.origin}${image.src}`;
  }
  const meta = image.meta as Record<string, unknown> | undefined;
  const storageKey =
    (typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
    (typeof image.id === "string" ? image.id : undefined);
  if (storageKey) {
    return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
  }
  return undefined;
}

const postData = (post.data || {}) as any;
const featuredImageUrl = getImageUrl(postData.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// SEOメタ情報の生成
const seo = getSeoMeta(post, {
  siteTitle: siteTitle || "女性専用サロン La Chouette（ラ・シュエット）",
  siteUrl: Astro.url.origin,
  path: Astro.url.pathname.replace(/\/$/, ""),
  defaultOgImage: featuredImageUrl,
});

// カテゴリー情報の判定・正規化（TypeScript型安全ガード）
const rawTermsCategory = postData.terms?.category?.[0];
const rawCategory = rawTermsCategory?.slug || postData.category || 'salon-notes';
const categorySlug = typeof rawCategory === 'object' && rawCategory !== null ? rawCategory.slug : String(rawCategory);

const categoryMap: Record<string, { name: string; subtitle: string; label: string }> = {
  'relationship': { name: '人と心地よく付き合う', subtitle: '人間関係としなやかな境界線', label: '人間関係・境界線' },
  'mind-relax': { name: '心の緊張をほどく', subtitle: 'がんばり屋さんの脱力論', label: '心・自律神経' },
  'body-care': { name: 'からだの声を聴く', subtitle: '身体の強張りと自律神経', label: '身体・巡り' },
  'lifestyle': { name: '夜と朝のセルフケア', subtitle: '自分を慈しむ余白の時間', label: 'セルフケア・余白' },
  'salon-notes': { name: 'セラピストの控え室より', subtitle: 'セラピストの視点・サロンの空気感', label: 'サロン通信' },
};

const currentCategory = categoryMap[categorySlug] || { name: 'セラピストの控え室より', subtitle: 'セラピストの視点・サロンの空気感', label: 'サロン通信' };

const tags = postData.terms?.tag ?? [];
const readingTime = getReadingTime(postData.content);
const publishedAt = postData.publishedAt ?? null;
const publishDate = publishedAt ? formatDate(publishedAt, "long") : null;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seo.title || `${postData.title} | 女性専用サロン La Chouette`}</title>
  <meta name="description" content={seo.description || `${postData.title} - 滋賀県草津市の女性専用完全個室サロン「ラ・シュエット」のブログです。`} />

  <!-- Tailwind CSS v3 CDN（is:inline 必須） -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            alabaster: '#F7F4EF',
            champagne: '#EDE7DF',
            sand: '#DCD3C6',
            bronze: '#8E735B',
            charcoal: '#221F1D',
            taupe: '#7D7571',
          }
        }
      }
    }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <style is:global>
    body {
      font-family: 'Zen Kaku Gothic New', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #F7F4EF;
      color: #221F1D;
    }
    .font-mincho {
      font-family: 'Shippori Mincho', serif;
    }

    /* 装飾ボックス基本スタイル */
    .box-fusen {
      background-color: #EDE7DF;
      border-left: 5px solid #8E735B;
      padding: 1.25rem 1.5rem;
      margin: 2rem 0;
      border-radius: 0 0.5rem 0.5rem 0;
      color: #221F1D;
      line-height: 1.85;
    }

    .box-point {
      position: relative;
      background-color: #FFFFFF;
      border: 1px solid #8E735B;
      border-radius: 0.5rem;
      padding: 1.75rem 1.5rem 1.25rem;
      margin: 2.25rem 0 1.75rem;
      line-height: 1.85;
    }
    .box-point::before {
      content: 'POINT';
      position: absolute;
      top: -0.75rem;
      left: 1.25rem;
      background-color: #8E735B;
      color: #FFFFFF;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      padding: 0.15rem 0.85rem;
      border-radius: 9999px;
    }

    .box-check {
      position: relative;
      background-color: #FFFFFF;
      border: 1px solid #DCD3C6;
      border-radius: 0.5rem;
      padding: 1.75rem 1.5rem 1.25rem;
      margin: 2.25rem 0 1.75rem;
      line-height: 1.85;
    }
    .box-check::before {
      content: 'CHECK';
      position: absolute;
      top: -0.75rem;
      left: 1.25rem;
      background-color: #7D7571;
      color: #FFFFFF;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      padding: 0.15rem 0.85rem;
      border-radius: 9999px;
    }

    .box-inset {
      background-color: #EDE7DF;
      box-shadow: inset 0 2px 4px rgba(34, 31, 29, 0.05);
      border-radius: 0.75rem;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      color: #221F1D;
      line-height: 1.85;
    }

    .box-bracket {
      position: relative;
      background-color: #FFFFFF;
      padding: 1.75rem 2rem;
      margin: 2.25rem 0;
      border-radius: 0.25rem;
      line-height: 1.85;
    }
    .box-bracket::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 24px;
      height: 24px;
      border-top: 2px solid #8E735B;
      border-left: 2px solid #8E735B;
    }
    .box-bracket::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: 0;
      width: 24px;
      height: 24px;
      border-bottom: 2px solid #8E735B;
      border-right: 2px solid #8E735B;
    }

    .box-double {
      background-color: #FFFFFF;
      border: 3px double #8E735B;
      border-radius: 0.375rem;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      line-height: 1.85;
    }

    .box-stitch {
      background-color: #FAF8F5;
      border: 1.5px dashed #DCD3C6;
      border-radius: 0.5rem;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      line-height: 1.85;
    }

    .box-folded {
      position: relative;
      background-color: #EDE7DF;
      border-radius: 0.375rem;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      line-height: 1.85;
    }

    .box-stripe {
      background: repeating-linear-gradient(45deg, #FAF8F5, #FAF8F5 10px, #EDE7DF 10px, #EDE7DF 20px);
      border: 1px solid #DCD3C6;
      border-radius: 0.5rem;
      padding: 1.5rem 1.75rem;
      margin: 2rem 0;
      line-height: 1.85;
    }

    .box-info {
      position: relative;
      background-color: #FAF8F5;
      border: 1px solid #DCD3C6;
      border-radius: 0.5rem;
      padding: 1.75rem 1.5rem 1.25rem;
      margin: 2.25rem 0 1.75rem;
      line-height: 1.85;
    }
    .box-info::before {
      content: 'i';
      position: absolute;
      top: -0.75rem;
      left: 1.25rem;
      background-color: #8E735B;
      color: #FFFFFF;
      font-size: 0.85rem;
      font-weight: 700;
      font-family: serif;
      width: 1.5rem;
      height: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
    }

    .box-question {
      position: relative;
      background-color: #FAF8F5;
      border: 1px solid #8E735B;
      border-radius: 0.5rem;
      padding: 1.75rem 1.5rem 1.25rem;
      margin: 2.25rem 0 1.75rem;
      line-height: 1.85;
    }
    .box-question::before {
      content: '?';
      position: absolute;
      top: -0.75rem;
      left: 1.25rem;
      background-color: #7D7571;
      color: #FFFFFF;
      font-size: 0.85rem;
      font-weight: 700;
      width: 1.5rem;
      height: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
    }

    .box-alert {
      position: relative;
      background-color: #FAF8F5;
      border: 1px solid #B45309;
      border-radius: 0.5rem;
      padding: 1.75rem 1.5rem 1.25rem;
      margin: 2.25rem 0 1.75rem;
      line-height: 1.85;
    }
    .box-alert::before {
      content: '!';
      position: absolute;
      top: -0.75rem;
      left: 1.25rem;
      background-color: #B45309;
      color: #FFFFFF;
      font-size: 0.85rem;
      font-weight: 700;
      width: 1.5rem;
      height: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
    }

    .marker-bronze {
      background: linear-gradient(transparent 60%, rgba(142, 115, 91, 0.25) 60%);
      font-weight: 600;
      padding: 0 0.15rem;
    }

    /* セラピスト吹き出し */
    .speech-therapist {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      margin: 2rem 0;
    }
    .speech-therapist .avatar {
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      background-color: #8E735B;
      color: #FFFFFF;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      white-space: nowrap;
      flex-shrink: 0;
      margin-top: 0.25rem;
    }
    .speech-therapist .bubble {
      position: relative;
      background-color: #EDE7DF;
      color: #221F1D;
      padding: 1.1rem 1.35rem;
      border-radius: 1rem;
      border-top-left-radius: 0;
      font-size: 0.925rem;
      line-height: 1.85;
      border: 1px solid #DCD3C6;
    }

    /* お客様吹き出し */
    .speech-client {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      margin: 2rem 0;
    }
    .speech-client .avatar {
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      background-color: #EDE7DF;
      border: 1px solid #DCD3C6;
      color: #7D7571;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      white-space: nowrap;
      flex-shrink: 0;
      margin-top: 0.25rem;
    }
    .speech-client .bubble {
      position: relative;
      background-color: #FFFFFF;
      color: #221F1D;
      padding: 1.1rem 1.35rem;
      border-radius: 1rem;
      border-top-left-radius: 0;
      font-size: 0.925rem;
      line-height: 1.85;
      border: 1px solid #DCD3C6;
      box-shadow: 0 1px 3px rgba(34, 31, 29, 0.03);
    }

    /* ブログカード装飾（内部記事・外部リンク共用） */
    .blog-card-link {
      display: flex;
      flex-direction: column;
      background-color: #FAF8F5;
      border: 1px solid #DCD3C6;
      border-radius: 0.875rem;
      margin: 2.5rem 0;
      text-decoration: none;
      overflow: hidden;
      transition: all 0.25s ease;
      box-shadow: 0 1px 4px rgba(34, 31, 29, 0.03);
    }
    @media (min-width: 640px) {
      .blog-card-link {
        flex-direction: row;
        align-items: stretch;
      }
    }
    .blog-card-link:hover {
      border-color: #8E735B;
      background-color: #FFFFFF;
      box-shadow: 0 6px 18px rgba(142, 115, 91, 0.12);
      transform: translateY(-2px);
    }
    .blog-card-image-wrap {
      width: 100%;
      height: 160px;
      background-color: #EDE7DF;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    @media (min-width: 640px) {
      .blog-card-image-wrap {
        width: 220px;
        height: auto;
      }
    }
    .blog-card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
    .blog-card-link:hover .blog-card-image {
      transform: scale(1.03);
    }
    .blog-card-body {
      padding: 1.25rem 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex-grow: 1;
    }
    .blog-card-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background-color: #8E735B;
      color: #FFFFFF;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      padding: 0.15rem 0.6rem;
      border-radius: 9999px;
      margin-bottom: 0.5rem;
      align-self: flex-start;
    }
    .blog-card-tag.is-external {
      background-color: #7D7571;
    }
    .blog-card-title {
      font-family: 'Shippori Mincho', serif;
      font-size: 1.05rem;
      font-weight: 600;
      color: #221F1D;
      line-height: 1.5;
      margin-bottom: 0.35rem;
      transition: color 0.2s ease;
      word-break: break-word;
    }
    .blog-card-link:hover .blog-card-title {
      color: #8E735B;
    }
    .blog-card-desc {
      font-size: 0.825rem;
      color: #7D7571;
      line-height: 1.6;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 0.35rem;
    }
    .blog-card-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.35rem;
      margin-top: 0.65rem;
      font-size: 0.75rem;
      color: #8E735B;
      font-weight: 500;
    }
    .blog-card-domain {
      font-size: 0.725rem;
      color: #7D7571;
      margin-right: auto;
      font-family: monospace;
    }

    .entry-content h2 {
      font-family: 'Shippori Mincho', serif;
      font-size: 1.35rem;
      font-weight: 600;
      color: #221F1D;
      border-left: 4px solid #8E735B;
      padding: 0.35rem 0 0.35rem 0.85rem;
      margin-top: 3rem;
      margin-bottom: 1.5rem;
      line-height: 1.45;
    }
    @media (min-width: 768px) {
      .entry-content h2 {
        font-size: 1.5rem;
      }
    }
    .entry-content h3 {
      font-family: 'Shippori Mincho', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: #221F1D;
      border-bottom: 1px solid #DCD3C6;
      padding-bottom: 0.5rem;
      margin-top: 2.25rem;
      margin-bottom: 1.25rem;
      line-height: 1.4;
    }
    .entry-content p {
      color: #221F1D;
      font-size: 0.975rem;
      line-height: 2;
      margin-bottom: 1.6rem;
      letter-spacing: 0.02em;
    }
  </style>
</head>

<body class="min-h-screen flex flex-col antialiased">
  <Header />

  <main class="flex-grow pt-24 pb-20">
    <article class="max-w-3xl mx-auto px-5 sm:px-8">
      
      <!-- パンくずリスト -->
      <nav class="flex items-center gap-2 text-xs text-taupe mb-8 overflow-x-auto whitespace-nowrap py-1">
        <a href="/" class="hover:text-bronze transition-colors">ホーム</a>
        <span>/</span>
        <a href="/posts" class="hover:text-bronze transition-colors">コラム一覧</a>
        <span>/</span>
        <a href={`/category/${categorySlug}`} class="hover:text-bronze transition-colors">{currentCategory.name}</a>
      </nav>

      <!-- 記事ヘッダー -->
      <header class="mb-10 text-center border-b border-sand pb-8">
        <div class="inline-flex flex-wrap items-center justify-center gap-2 mb-4">
          <a
            href={`/category/${categorySlug}`}
            class="text-xs tracking-wider px-3.5 py-1 bg-champagne text-bronze rounded-full font-medium border border-sand hover:bg-sand/40 transition-colors"
          >
            {currentCategory.label}
          </a>
          {tags.map((t: any) => (
            <span class="text-xs tracking-wider px-3 py-1 bg-alabaster text-taupe rounded-full font-medium border border-sand">
              {t.label}
            </span>
          ))}
          {publishDate && (
            <time class="text-xs text-taupe tracking-wider font-mono">{publishDate}</time>
          )}
          {readingTime && (
            <span class="text-xs text-taupe tracking-wider">読了目安 {readingTime}分</span>
          )}
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-[32px] font-mincho text-charcoal font-medium leading-relaxed sm:leading-relaxed">
          {postData.title}
        </h1>

        {postData.excerpt && (
          <p class="text-sm text-taupe mt-4 leading-relaxed max-w-xl mx-auto">
            {postData.excerpt}
          </p>
        )}
      </header>

      <!-- アイキャッチ画像 -->
      {postData.featured_image && (
        <div class="mb-12 overflow-hidden rounded-2xl shadow-sm border border-sand">
          <Image
            image={postData.featured_image}
            sizes="(min-width: 1024px) 768px, 92vw"
            class="w-full h-auto object-cover max-h-[440px]"
            priority
          />
        </div>
      )}

      <!-- 記事本文 -->
      <div class="entry-content" id="post-content">
        <PortableText value={postData.content} />
      </div>

      <!-- 相談窓口CTAの展開用コンポーネント（非表示待機） -->
      <div id="counseling-cta-template" style="display: none;">
        <CounselingCta />
      </div>

      <!-- セラピストの控え室カテゴリー用：タグ未記入時の自動配置エリア -->
      {categorySlug === 'salon-notes' && (
        <div id="counseling-cta-auto" style="display: none;">
          <CounselingCta />
        </div>
      )}

      <!-- スクリプト構文干渉対策済み変換ロジック -->
      <script is:inline>
        (function() {
          const container = document.getElementById('post-content');
          if (!container) return;

          let html = container.innerHTML;

          // エスケープされた div の復元
          html = html.replace(/&lt;div class="([^"]+)"&gt;([\s\S]*?)&lt;\/div&gt;/gi, '\x3cdiv class="$1"\x3e$2\x3c/div\x3e');

          // 相談窓口CTAプレースホルダーへの置換（【問い合わせ】【相談窓口】[[問い合わせ]] 等に対応）
          html = html.replace(/<p>\s*(?:【(?:問い合わせ|問い合わせる|相談窓口|相談)】|\[\[(?:問い合わせ|問い合わせる|相談窓口|相談)\]\])\s*<\/p>|(?:【(?:問い合わせ|問い合わせる|相談窓口|相談)】|\[\[(?:問い合わせ|問い合わせる|相談窓口|相談)\]\])/gi, '\x3cdiv class="counseling-cta-placeholder"\x3e\x3c/div\x3e');

          // 吹き出し
          html = html.replace(/【(?:セラピスト|私)】([\s\S]*?)【\/(?:セラピスト|私)】/gi, '\x3cdiv class="speech-therapist"\x3e\x3cdiv class="avatar"\x3eセラピスト\x3c/div\x3e\x3cdiv class="bubble"\x3e$1\x3c/div\x3e\x3c/div\x3e');
          html = html.replace(/【(?:お客様|相談)】([\s\S]*?)【\/(?:お客様|相談)】/gi, '\x3cdiv class="speech-client"\x3e\x3cdiv class="avatar"\x3eお客様\x3c/div\x3e\x3cdiv class="bubble"\x3e$1\x3c/div\x3e\x3c/div\x3e');

          // 各種装飾ボックス
          html = html.replace(/【(?:POINT|ポイント)】([\s\S]*?)【\/(?:POINT|ポイント)】/gi, '\x3cdiv class="box-point"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:CHECK|チェック)】([\s\S]*?)【\/(?:CHECK|チェック)】/gi, '\x3cdiv class="box-check"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:付箋|つぶやき)】([\s\S]*?)【\/(?:付箋|つぶやき)】/gi, '\x3cdiv class="box-fusen"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:かぎ括弧|言葉)】([\s\S]*?)【\/(?:かぎ括弧|言葉)】/gi, '\x3cdiv class="box-bracket"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:カード|窪み)】([\s\S]*?)【\/(?:カード|窪み)】/gi, '\x3cdiv class="box-inset"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:二重線|ダブル)】([\s\S]*?)【\/(?:二重線|ダブル)】/gi, '\x3cdiv class="box-double"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:スティッチ|点線)】([\s\S]*?)【\/(?:スティッチ|点線)】/gi, '\x3cdiv class="box-stitch"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:角折り|メモ用紙)】([\s\S]*?)【\/(?:角折り|メモ用紙)】/gi, '\x3cdiv class="box-folded"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:ストライプ|斜線)】([\s\S]*?)【\/(?:ストライプ|斜線)】/gi, '\x3cdiv class="box-stripe"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:インフォ|info)】([\s\S]*?)【\/(?:インフォ|info)】/gi, '\x3cdiv class="box-info"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:はてな|疑問)】([\s\S]*?)【\/(?:はてな|疑問)】/gi, '\x3cdiv class="box-question"\x3e$1\x3c/div\x3e');
          html = html.replace(/【(?:注意|アラート)】([\s\S]*?)【\/(?:注意|アラート)】/gi, '\x3cdiv class="box-alert"\x3e$1\x3c/div\x3e');

          // マーカー
          html = html.replace(/【(?:マーカー|強調)】([\s\S]*?)【\/(?:マーカー|強調)】/gi, '\x3cspan class="marker-bronze"\x3e$1\x3c/span\x3e');

          // 手動タグ（【こちらもどうぞ】【外部リンク】等）
          html = html.replace(/<p>\s*【(?:こちらもどうぞ|あわせて読みたい|ブログカード|関連記事|外部リンク|参考リンク)】([\s\S]*?)【\/(?:こちらもどうぞ|あわせて読みたい|ブログカード|関連記事|外部リンク|参考リンク)】\s*<\/p>|【(?:こちらもどうぞ|あわせて読みたい|ブログカード|関連記事|外部リンク|参考リンク)】([\s\S]*?)【\/(?:こちらもどうぞ|あわせて読みたい|ブログカード|関連記事|外部リンク|参考リンク)】/gi, function(match, content1, content2) {
            const raw = content1 || content2 || '';
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = raw;
            const linkElem = tempDiv.querySelector('a');
            let href = linkElem ? (linkElem.getAttribute('href') || '') : '';
            tempDiv.querySelectorAll('br').forEach(function(br) { br.replaceWith('\n'); });
            tempDiv.querySelectorAll('p').forEach(function(p) { p.after('\n'); });
            const parts = (tempDiv.textContent || '').split(/[\n|｜]+/).map(function(s) { return s.trim(); }).filter(Boolean);
            let url = href || '';
            let title = '';
            let desc = '';
            for (let i = 0; i < parts.length; i++) {
              const part = parts[i];
              if (!url && (part.startsWith('http') || part.startsWith('/'))) url = part;
              else if (!title) title = part;
              else if (!desc) desc = part;
            }
            if (!url) return '';
            return '\x3cdiv class="auto-blog-card-target" data-url="' + url + '" data-title="' + (title || '') + '" data-desc="' + (desc || '') + '"\x3e\x3c/div\x3e';
          });

          // 見出し変換
          html = html.replace(/<p>\s*###\s+(.*?)<\/p>/gi, '\x3ch3\x3e$1\x3c/h3\x3e');
          html = html.replace(/<p>\s*##\s+(.*?)<\/p>/gi, '\x3ch2\x3e$1\x3c/h2\x3e');
          html = html.replace(/###\s+([^<\n]+)/gi, '\x3ch3\x3e$1\x3c/h3\x3e');
          html = html.replace(/##\s+([^<\n]+)/gi, '\x3ch2\x3e$1\x3c/h2\x3e');

          // 孤立した # の消去
          html = html.replace(/<p>\s*#+\s*<\/p>/gi, '');
          html = html.replace(/(?:^|\n)\s*#+\s*(?=\n|$)/g, '');

          container.innerHTML = html;

          // ==========================================
          // 相談窓口CTAの実装展開
          // ==========================================
          const ctaTemplate = document.getElementById('counseling-cta-template');
          const ctaPlaceholders = container.querySelectorAll('.counseling-cta-placeholder');

          if (ctaTemplate) {
            if (ctaPlaceholders.length > 0) {
              ctaPlaceholders.forEach(function(placeholder) {
                placeholder.innerHTML = ctaTemplate.innerHTML;
              });
            } else {
              // 記事内に手動タグがなく「セラピストの控え室より」カテゴリーの場合は末尾に自動展開
              const autoCta = document.getElementById('counseling-cta-auto');
              if (autoCta) {
                autoCta.style.display = 'block';
              }
            }
          }

          // ==========================================
          // 独立URL（内部記事・外部サイトURL両対応）の自動ブログカード化
          // ==========================================
          const paragraphs = container.querySelectorAll('p');
          paragraphs.forEach(function(p) {
            const text = p.textContent.trim();
            const link = p.querySelector('a');

            let targetUrl = '';
            if (link && p.childNodes.length === 1) {
              const href = link.getAttribute('href') || '';
              if (href.startsWith('http://') || href.startsWith('https://') || href.startsWith('/posts/')) {
                targetUrl = href;
              }
            } else if (text.startsWith('http://') || text.startsWith('https://') || text.startsWith('/posts/')) {
              // 空白を含まない単一URL行か判定
              if (!/\s/.test(text)) {
                targetUrl = text;
              }
            }

            if (targetUrl) {
              const placeholder = document.createElement('div');
              placeholder.className = 'auto-blog-card-target';
              placeholder.setAttribute('data-url', targetUrl);
              p.parentNode.replaceChild(placeholder, p);
            }
          });

          // カード対象を一括処理＆レンダリング
          const cardTargets = container.querySelectorAll('.auto-blog-card-target');
          cardTargets.forEach(function(target) {
            const rawUrl = target.getAttribute('data-url');
            const customTitle = target.getAttribute('data-title');
            const customDesc = target.getAttribute('data-desc');

            if (!rawUrl) return;

            let isInternal = false;
            let fetchPath = rawUrl;
            let domain = '';

            try {
              if (rawUrl.startsWith('/')) {
                isInternal = true;
                domain = window.location.hostname;
              } else if (rawUrl.startsWith('http')) {
                const parsed = new URL(rawUrl);
                domain = parsed.hostname;
                if (parsed.origin === window.location.origin) {
                  isInternal = true;
                  fetchPath = parsed.pathname;
                }
              }
            } catch(e) {}

            // 内部リンク（自サイト記事）の場合はOGP・タイトルを非同期取得
            if (isInternal) {
              fetch(fetchPath)
                .then(function(res) {
                  if (!res.ok) throw new Error('Fetch failed');
                  return res.text();
                })
                .then(function(pageHtml) {
                  const doc = new DOMParser().parseFromString(pageHtml, 'text/html');
                  const title = customTitle || 
                                doc.querySelector('meta[property="og:title"]')?.getAttribute('content')?.replace(/ \| .*/, '') || 
                                doc.querySelector('h1')?.textContent?.trim() || 
                                (doc.title ? doc.title.replace(/ \| .*/, '') : '') || 
                                '記事を読む';

                  const desc = customDesc || 
                               doc.querySelector('meta[property="og:description"]')?.getAttribute('content') || 
                               doc.querySelector('meta[name="description"]')?.getAttribute('content') || 
                               '';

                  const ogImage = doc.querySelector('meta[property="og:image"]')?.getAttribute('content') || '';

                  const imageHtml = ogImage
                    ? '\x3cdiv class="blog-card-image-wrap"\x3e\x3cimg src="' + ogImage + '" alt="' + title + '" class="blog-card-image" loading="lazy" /\x3e\x3c/div\x3e'
                    : '';

                  const descHtml = desc ? '\x3cdiv class="blog-card-desc"\x3e' + desc + '\x3c/div\x3e' : '';

                  target.outerHTML =
                    '\x3ca href="' + rawUrl + '" class="blog-card-link"\x3e' +
                      imageHtml +
                      '\x3cdiv class="blog-card-body"\x3e' +
                        '\x3cdiv class="blog-card-tag"\x3e' +
                          '\x3csvg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"\x3e\x3cpath stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /\x3e\x3c/svg\x3e' +
                          'こちらもどうぞ' +
                        '\x3c/div\x3e' +
                        '\x3cdiv class="blog-card-title"\x3e' + title + '\x3c/div\x3e' +
                        descHtml +
                        '\x3cdiv class="blog-card-footer"\x3e' +
                          '\x3cspan\x3e記事を読む\x3c/span\x3e' +
                          '\x3csvg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"\x3e\x3cpath stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /\x3e\x3c/svg\x3e' +
                        '\x3c/div\x3e' +
                      '\x3c/div\x3e' +
                    '\x3c/a\x3e';
                })
                .catch(function() {
                  renderFallbackCard(target, rawUrl, customTitle || rawUrl, customDesc, 'こちらもどうぞ', false);
                });
            } else {
              // 外部リンクの場合（CORS制約を回避し洗練された外部カードとして即時レンダリング）
              const displayTitle = customTitle || rawUrl;
              renderFallbackCard(target, rawUrl, displayTitle, customDesc, '外部リンク', true, domain);
            }
          });

          function renderFallbackCard(target, url, title, desc, tagText, isExternal, domain) {
            const tagClass = isExternal ? 'blog-card-tag is-external' : 'blog-card-tag';
            const iconSvg = isExternal
              ? '\x3csvg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"\x3e\x3cpath stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /\x3e\x3c/svg\x3e'
              : '\x3csvg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"\x3e\x3cpath stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /\x3e\x3c/svg\x3e';

            const descHtml = desc ? '\x3cdiv class="blog-card-desc"\x3e' + desc + '\x3c/div\x3e' : '';
            const domainHtml = domain ? '\x3cspan class="blog-card-domain"\x3e' + domain + '\x3c/span\x3e' : '';
            const targetAttr = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
            const actionText = isExternal ? 'サイトを見る' : '記事を読む';

            target.outerHTML =
              '\x3ca href="' + url + '" class="blog-card-link"' + targetAttr + ' style="padding:1.25rem 1.5rem;"\x3e' +
                '\x3cdiv class="blog-card-body" style="padding:0;"\x3e' +
                  '\x3cdiv class="' + tagClass + '"\x3e' +
                    iconSvg +
                    tagText +
                  '\x3c/div\x3e' +
                  '\x3cdiv class="blog-card-title"\x3e' + title + '\x3c/div\x3e' +
                  descHtml +
                  '\x3cdiv class="blog-card-footer"\x3e' +
                    domainHtml +
                    '\x3cspan\x3e' + actionText + '\x3c/span\x3e' +
                    '\x3csvg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"\x3e\x3cpath stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /\x3e\x3c/svg\x3e' +
                  '\x3c/div\x3e' +
                '\x3c/div\x3e' +
              '\x3c/a\x3e';
          }
        })();
      </script>

      <!-- 著者紹介（男性セラピスト 高橋） -->
      <div class="mt-16 pt-10 border-t border-sand">
        <div class="bg-champagne/40 rounded-2xl p-6 sm:p-8 border border-sand">
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
            <img
              src="https://kusatsu-aroma.com/_emdash/api/media/file/01M661ZK0REMWT6T12ZTGXXMM5.01M661ZKQ84Q0X5VSYND61F1A7.jpeg"
              alt="男性セラピスト 高橋"
              class="w-16 h-16 rounded-full object-cover object-top flex-shrink-0 border-2 border-white shadow-xs"
            />
            <div class="flex-grow text-center sm:text-left">
              <div class="flex items-center justify-center sm:justify-start gap-2 mb-2">
                <span class="text-xs font-medium text-bronze bg-white px-2.5 py-0.5 rounded-full border border-sand">男性セラピスト</span>
                <span class="text-sm font-mincho font-bold text-charcoal">高橋（La Chouette）</span>
              </div>
              <p class="text-xs sm:text-sm text-taupe leading-relaxed">
                滋賀県草津市の女性専用完全個室サロン「ラ・シュエット」を運営しています。日常の役割や気遣いから少し離れ、ご自身の呼吸と身体の重みを取り戻せる静かな余白の時間をお届けしています。
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- 予約・LINE導線CTA（サロン施術用：セラピストの控え室カテゴリー以外で表示） -->
      {categorySlug !== 'salon-notes' && (
        <section class="mt-12 bg-gradient-to-br from-champagne/60 to-alabaster rounded-3xl p-7 sm:p-10 border border-sand text-center shadow-xs">
          <span class="text-xs font-mincho tracking-widest text-bronze uppercase">Reservation & Care</span>
          <h2 class="text-xl sm:text-2xl font-mincho text-charcoal font-medium mt-2 mb-3">
            心と身体をゆるめる、静かな休息の時間へ
          </h2>
          <p class="text-sm text-taupe max-w-lg mx-auto leading-relaxed mb-8">
            草津市の完全個室サロン「ラ・シュエット」では、温かいホホバオイルを用いたオールハンドのトリートメントで、日々の緊張をほどく深い癒やしの時間をご提供しています。
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
            <a
              href="https://app.squareup.com/appointments/book/fqk7s06sbwkojt/L7STD9CD9RRTC/start"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto flex-1 inline-flex items-center justify-center px-6 py-3.5 bg-bronze text-white text-sm tracking-wider rounded-full hover:bg-[#78614C] transition duration-300 shadow-sm"
            >
              サロンWeb予約（Square）
            </a>

            <a
              href="https://lin.ee/Sv8oVDh"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto flex-1 inline-flex items-center justify-center px-6 py-3.5 bg-[#06C755] text-white text-sm tracking-wider rounded-full hover:opacity-95 transition duration-300 shadow-sm"
            >
              公式LINEで相談する
            </a>
          </div>

          <p class="text-xs text-taupe/90 mt-6 leading-relaxed max-w-md mx-auto">
            ※ 出張オイルトリートメントは移動時間と枠の事前調整が必要なため、Squareの即時予約は設けておりません。公式LINEまたはお電話（080-6219-3290）よりお気軽にご相談ください。
          </p>
        </section>
      )}

      <!-- 前後のナビゲーション -->
      <div class="mt-12 pt-6 border-t border-sand flex items-center justify-between text-sm">
        <a href="/posts" class="inline-flex items-center gap-2 text-taupe hover:text-bronze transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          コラム一覧へ戻る
        </a>
        <a href={`/category/${categorySlug}`} class="inline-flex items-center gap-2 text-bronze hover:underline">
          「{currentCategory.name}」をもっと読む
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </article>
  </main>

  <Footer />
</body>
</html>
