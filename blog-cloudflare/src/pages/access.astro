---
// templates/blog-cloudflare/src/pages/access.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "アクセス・店舗情報 | 女性専用サロン La Chouette（ラ・シュエット）";
const pageDescription = "JR草津駅東口より徒歩9分。滋賀県草津市大路の女性専用プライベートアロマサロン La Chouette へのアクセス、駐車場のご案内、道順についてご説明いたします。";
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Noto+Serif+JP:wght@200;300;400;500&family=Noto+Sans+JP:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN (is:inline 必須) -->
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            alabaster: '#F7F4EF',
            champagne: '#EDE7DF',
            sand: '#DCD3C6',
            bronze: '#8E735B',
            charcoal: '#221F1D',
            taupe: '#7D7571',
          },
          fontFamily: {
            serif: ['"Noto Serif JP"', '"Cormorant Garamond"', 'serif'],
            sans: ['"Noto Sans JP"', 'sans-serif'],
            en: ['"Cormorant Garamond"', 'serif'],
          }
        }
      }
    }
  </script>
</head>

<body class="bg-alabaster text-charcoal font-sans antialiased min-h-screen flex flex-col selection:bg-sand selection:text-charcoal">
  <!-- グローバルヘッダー -->
  <Header />

  <main class="flex-grow">
    <!-- ヒーローヘッダー -->
    <section class="py-16 sm:py-20 border-b border-sand/40 bg-gradient-to-b from-champagne/40 to-alabaster text-center px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs sm:text-sm font-en tracking-[0.3em] text-bronze uppercase mb-2">ACCESS & SALON INFO</p>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-serif text-charcoal tracking-widest font-normal">
          アクセス・店舗案内
        </h1>
        <div class="w-10 h-[1px] bg-bronze/60 mx-auto mt-4 mb-4"></div>
        <p class="text-xs sm:text-sm text-taupe leading-relaxed font-light">
          JR草津駅東口より徒歩9分。日常の喧騒から少し離れた、静かな完全個室の空間でお迎えいたします。
        </p>
      </div>
    </section>

    <!-- メインコンテンツコンテナ -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-16">

      <!-- サロン基本情報カード -->
      <section class="bg-champagne/30 border border-sand/50 rounded-sm p-6 sm:p-8">
        <h2 class="text-lg sm:text-xl font-serif tracking-widest text-charcoal mb-6 flex items-center">
          <span class="w-1.5 h-4 bg-bronze mr-3"></span>サロン基本情報
        </h2>

        <dl class="grid grid-cols-1 md:grid-cols-3 gap-y-4 md:gap-y-6 text-xs sm:text-sm border-t border-sand/40 pt-4">
          <dt class="text-taupe font-medium">サロン名</dt>
          <dd class="md:col-span-2 text-charcoal font-light">
            La Chouette（ラ・シュエット）
            <span class="block text-[11px] text-taupe mt-0.5">女性専用・完全個室プライベートサロン</span>
          </dd>

          <dt class="text-taupe font-medium">所在地</dt>
          <dd class="md:col-span-2 text-charcoal font-light">
            滋賀県草津市大路
            <span class="block text-[11px] text-taupe mt-0.5">※完全個室のプライベート空間のため、詳細な建物名・部屋番号はご予約確定時にお伝えしております。</span>
          </dd>

          <dt class="text-taupe font-medium">最寄り駅</dt>
          <dd class="md:col-span-2 text-charcoal font-light">
            JR琵琶湖線・草津線「草津駅」東口より徒歩9分
          </dd>

          <dt class="text-taupe font-medium">営業時間</dt>
          <dd class="md:col-span-2 text-charcoal font-light">
            8:00 〜 27:00（完全予約制）
          </dd>

          <dt class="text-taupe font-medium">お電話</dt>
          <dd class="md:col-span-2 text-charcoal font-light">
            <a href="tel:08062193290" class="text-bronze hover:underline font-mono text-sm sm:text-base">080-6219-3290</a>
            <span class="block text-[11px] text-taupe mt-0.5">※施術中はお電話に出られない場合がございます。留守番電話にメッセージを残していただければ折り返しご連絡いたします。</span>
          </dd>
        </dl>
      </section>

      <!-- 電車・徒歩でのルート -->
      <section class="space-y-6">
        <div class="border-b border-sand/40 pb-3">
          <p class="text-[11px] font-en tracking-widest text-bronze uppercase">TRAIN & WALK</p>
          <h2 class="text-xl sm:text-2xl font-serif text-charcoal tracking-wide">JR草津駅からの徒歩ルート</h2>
        </div>

        <p class="text-xs sm:text-sm text-taupe font-light leading-relaxed">
          JR草津駅東口のペデストリアンデッキを抜け、商業エリアを通り抜けた落ち着きのある住宅街にございます。平坦な道なりで、徒歩約9分ほどで到着いたします。
        </p>

        <!-- ルートステップ -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="bg-champagne/20 border border-sand/40 p-5 rounded-sm flex flex-col justify-between">
            <div>
              <span class="text-xs font-en text-bronze tracking-widest">STEP 01</span>
              <h3 class="text-sm font-medium text-charcoal mt-1 mb-2">草津駅 東口を出る</h3>
              <p class="text-xs text-taupe font-light leading-relaxed">
                改札を出て右手の東口方面へ進み、地上階へ降ります。
              </p>
            </div>
          </div>

          <div class="bg-champagne/20 border border-sand/40 p-5 rounded-sm flex flex-col justify-between">
            <div>
              <span class="text-xs font-en text-bronze tracking-widest">STEP 02</span>
              <h3 class="text-sm font-medium text-charcoal mt-1 mb-2">草津川跡地公園（de愛広場）方面へ</h3>
              <p class="text-xs text-taupe font-light leading-relaxed">
                大路のメイン通りを進み、緑豊かなde愛広場方面へと直進します。
              </p>
            </div>
          </div>

          <div class="bg-champagne/20 border border-sand/40 p-5 rounded-sm flex flex-col justify-between">
            <div>
              <span class="text-xs font-en text-bronze tracking-widest">STEP 03</span>
              <h3 class="text-sm font-medium text-charcoal mt-1 mb-2">当サロン マンションへ</h3>
              <p class="text-xs text-taupe font-light leading-relaxed">
                閑静な住宅街にあるマンションです。オートロックにてお呼び出しください。
              </p>
            </div>
          </div>
        </div>

        <!-- 建物外観とインターフォン案内 -->
        <div class="mt-8 pt-6 border-t border-sand/30">
          <h3 class="text-base font-serif text-charcoal mb-4">マンション外観・エントランス</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- 外観画像 -->
            <div class="space-y-2">
              <div class="aspect-[4/3] bg-champagne/40 border border-sand/60 rounded-sm overflow-hidden flex items-center justify-center">
                <img 
                  src="/images/access/building.jpg" 
                  alt="サロンが入るマンションの外観" 
                  class="w-full h-full object-cover"
                  onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'text-xs text-taupe p-4 text-center font-light\'>［マンション外観写真］<br><span class=\'text-[10px] text-taupe/70\'>/images/access/building.jpg</span></div>';"
                />
              </div>
              <p class="text-xs text-taupe font-light">大通りから一本入った、落ち着いた環境のマンションです。</p>
            </div>

            <!-- インターフォン画像 -->
            <div class="space-y-2">
              <div class="aspect-[4/3] bg-champagne/40 border border-sand/60 rounded-sm overflow-hidden flex items-center justify-center">
                <img 
                  src="/images/access/intercom.jpg" 
                  alt="エントランスのインターフォン" 
                  class="w-full h-full object-cover"
                  onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'text-xs text-taupe p-4 text-center font-light\'>［インターフォン写真］<br><span class=\'text-[10px] text-taupe/70\'>/images/access/intercom.jpg</span></div>';"
                />
              </div>
              <p class="text-xs text-taupe font-light">エントランスにてご案内した部屋番号を呼び出してください。私が扉をお開けいたします。</p>
            </div>
          </div>
        </div>
      </section>

      <!-- お車でお越しの方（駐車場案内・注意喚起） -->
      <section class="space-y-6 pt-4 border-t border-sand/40">
        <div class="border-b border-sand/40 pb-3">
          <p class="text-[11px] font-en tracking-widest text-bronze uppercase">CAR & PARKING</p>
          <h2 class="text-xl sm:text-2xl font-serif text-charcoal tracking-wide">お車でお越しの方・近隣駐車場</h2>
        </div>

        <p class="text-xs sm:text-sm text-taupe font-light leading-relaxed">
          サロンのすぐ近くには「草津川跡地公園（de愛広場）東側駐車場」などのコインパーキングがございます。
        </p>

        <!-- 駐車場写真 2枚 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
          <div class="space-y-2">
            <div class="aspect-[4/3] bg-champagne/40 border border-sand/60 rounded-sm overflow-hidden flex items-center justify-center">
              <img 
                src="/images/access/parking-1.jpg" 
                alt="de愛広場東側駐車場 入口" 
                class="w-full h-full object-cover"
                onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'text-xs text-taupe p-4 text-center font-light\'>［de愛広場 駐車場写真 1］<br><span class=\'text-[10px] text-taupe/70\'>/images/access/parking-1.jpg</span></div>';"
              />
            </div>
            <p class="text-xs text-taupe font-light">de愛広場東側駐車場の入口付近。広々として入出庫しやすい駐車場です。</p>
          </div>

          <div class="space-y-2">
            <div class="aspect-[4/3] bg-champagne/40 border border-sand/60 rounded-sm overflow-hidden flex items-center justify-center">
              <img 
                src="/images/access/parking-2.jpg" 
                alt="de愛広場東側駐車場 駐車エリア" 
                class="w-full h-full object-cover"
                onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'text-xs text-taupe p-4 text-center font-light\'>［de愛広場 駐車場写真 2］<br><span class=\'text-[10px] text-taupe/70\'>/images/access/parking-2.jpg</span></div>';"
              />
            </div>
            <p class="text-xs text-taupe font-light">駐車場内からサロン方面へも徒歩数分の近さとなっております。</p>
          </div>
        </div>

        <!-- 駐車場に関するご案内・注意点カード -->
        <div class="p-5 sm:p-6 bg-champagne/50 border-l-2 border-bronze rounded-r-sm space-y-3">
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-bronze flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="text-xs sm:text-sm text-charcoal leading-relaxed font-light space-y-2">
              <p class="font-medium text-charcoal">
                近隣コインパーキングのご利用について
              </p>
              <p class="text-taupe">
                当サロン専用の提携駐車場はございません。お車でお越しの際は、サロン近くのコインパーキング（de愛広場 駐車場など）をご利用ください。
              </p>
              <p class="text-[11px] sm:text-xs text-taupe/90">
                ※ de愛広場でのイベント開催時などは、駐車場が満車となる可能性がございます。満車の際は、大変恐れ入りますが周辺の有料コインパーキングをご利用くださいますようお願い申し上げます。
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Googleマップ -->
      <section class="space-y-6 pt-4 border-t border-sand/40">
        <div class="border-b border-sand/40 pb-3">
          <p class="text-[11px] font-en tracking-widest text-bronze uppercase">MAP</p>
          <h2 class="text-xl sm:text-2xl font-serif text-charcoal tracking-wide">周辺地図</h2>
        </div>

        <!-- マップ埋め込み枠（草津市大路周辺） -->
        <div class="w-full h-80 sm:h-96 bg-champagne/30 border border-sand/60 rounded-sm overflow-hidden shadow-sm">
          <iframe 
            title="La Chouette 周辺地図"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3268.4972583857597!2d135.9598!3d35.0215!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6001718a221f57d1%3A0xa19565506a5b28a8!2z5ruL6LOA55yM6I2J5rSl5biC5aSn6Lev!5e0!3m2!1sja!2sjp!4v1710000000000!5m2!1sja!2sjp" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            class="filter contrast-[0.95] opacity-90 hover:opacity-100 transition-opacity"
          ></iframe>
        </div>
        <p class="text-[11px] text-taupe text-right font-light">
          ※詳細な所在地（マンション名・号室）は、防犯およびプライバシー保護のため、ご予約確定後に個別にお伝えしております。
        </p>
      </section>

      <!-- ご予約・お問い合わせ誘導セクション -->
      <section class="mt-16 p-8 bg-champagne/40 border border-sand/60 rounded-sm text-center space-y-6">
        <div>
          <p class="text-xs font-en tracking-[0.2em] text-bronze uppercase mb-1">RESERVATION & INQUIRY</p>
          <h2 class="text-xl sm:text-2xl font-serif text-charcoal tracking-wide">ご予約・お問い合わせ</h2>
          <p class="text-xs sm:text-sm text-taupe font-light mt-2 max-w-lg mx-auto leading-relaxed">
            道順に迷われた場合や、到着が前後する場合は、ご遠慮なくお電話または公式LINEよりご連絡ください。
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <a 
            href="/menu" 
            class="w-full sm:w-auto px-8 py-3 bg-bronze hover:bg-[#78614C] text-white text-xs tracking-widest uppercase transition-colors duration-200 shadow-sm"
          >
            施術メニュー・料金を見る
          </a>
          <a 
            href="tel:08062193290" 
            class="w-full sm:w-auto px-8 py-3 bg-transparent border border-bronze text-bronze hover:bg-bronze hover:text-white text-xs tracking-widest transition-colors duration-200"
          >
            お電話：080-6219-3290
          </a>
        </div>
      </section>

    </div>
  </main>

  <!-- グローバルフッター -->
  <Footer />
</body>
</html>
